---
import { getCollection, render } from 'astro:content'
import { getCardBySlug, getCardChildTopics, getSectionById, getSidebarItems } from '../../../../data/handbook'
import HandbookLayout from '../../../../layouts/HandbookLayout.astro'

export async function getStaticPaths() {
	const paths: { params: { section: string; card: string; slug: string }; props: { sectionId: string; cardId: string; topicId: string } }[] = []
	for (const section of ['learn', 'harness', 'mental-model', 'service', 'blocks', 'stores', 'expose', 'bridges', 'patterns', 'ops']) {
		for (const card of getSectionById(section)?.cards ?? []) {
			for (const topic of getCardChildTopics(section, card.id)) {
				if (topic.source?.collection !== 'handbookCards') continue
				paths.push({
					params: { section, card: card.id, slug: topic.canonicalRoute.split('/').filter(Boolean).at(-1)! },
					props: { sectionId: section, cardId: card.id, topicId: topic.topicId },
				})
			}
		}
	}
	return paths
}

const { sectionId, cardId, topicId } = Astro.props
const result = getCardBySlug(sectionId, cardId)
if (!result) {
	throw new Error(`Card not found: ${sectionId}/${cardId}`)
}
const { section, card, product } = result
const sidebar = getSidebarItems()
const topic = getCardChildTopics(sectionId, cardId).find(candidate => candidate.topicId === topicId)
if (!topic?.source || topic.source.collection !== 'handbookCards') {
	throw new Error(`Missing canonical handbook sub-page manifest entry for ${sectionId}/${cardId}/${topicId}`)
}

// Load MDX content for this sub-page
const cardEntries = await getCollection('handbookCards', entry => entry.id === topic.source!.id)
const cardEntry = cardEntries[0]
if (!cardEntry) {
	throw new Error(`Missing canonical handbook content for ${topic.source.id}`)
}
const rendered = await render(cardEntry)
const CardContent = rendered.Content
const cardHeadings = rendered.headings
---

<HandbookLayout
  title={cardEntry.data.title}
  description={cardEntry.data.description || card.description}
  sidebar={sidebar}
  currentId={topic.topicId}
  headings={cardHeadings}
  product={product}
>
  <nav class="flex items-center gap-2 text-sm text-[var(--color-fg-subtle)] mb-8">
    <a href="/handbook/" class="hover:text-[var(--color-fg)] transition-colors">Handbook</a>
    <span class="text-[var(--color-line-strong)]">/</span>
    <a href={`/handbook/${section.id}/`} class="hover:text-[var(--color-fg)] transition-colors">{section.title}</a>
    <span class="text-[var(--color-line-strong)]">/</span>
    <a href={`/handbook/${section.id}/${card.id}/`} class="hover:text-[var(--color-fg)] transition-colors">{card.title}</a>
    <span class="text-[var(--color-line-strong)]">/</span>
    <span class="text-[var(--color-fg)]">{cardEntry.data.title}</span>
  </nav>

  <div class="mb-10">
    <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase mb-2" style={`color: var(--color-${section.color}-hi)`}>
      {section.title} / {card.title}
    </p>
    <h1 class="font-display font-semibold text-[1.85rem] tracking-tight mb-3" style="color: var(--color-fg-strong); line-height: 1.15">
      {cardEntry.data.title}
    </h1>
    {cardEntry.data.description && (
      <p class="lede max-w-[70ch]">
        {cardEntry.data.description}
      </p>
    )}
  </div>
  <CardContent />
</HandbookLayout>
