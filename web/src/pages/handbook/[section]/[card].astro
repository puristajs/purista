---
import { getCollection, render } from 'astro:content'
import HandbookCard from '../../../components/handbook/HandbookCard.astro'
import SocScrolly from '../../../components/scrolly/SocScrolly.astro'
import { getCardBySlug, getNextTopic, getPreviousTopic, getProductCardTopics, getSidebarItems } from '../../../data/handbook'
import HandbookLayout from '../../../layouts/HandbookLayout.astro'

export async function getStaticPaths() {
	return ['framework', 'harness'].flatMap(product =>
		getProductCardTopics(product as 'framework' | 'harness').map(topic => ({
			params: { section: topic.sectionId!, card: topic.cardId! },
			props: { sectionId: topic.sectionId!, cardId: topic.cardId! },
		})),
	)
}

const { sectionId, cardId } = Astro.props
const result = getCardBySlug(sectionId, cardId)
if (!result) {
	throw new Error(`Card not found: ${sectionId}/${cardId}`)
}
const { section, card, product } = result
const sidebar = getSidebarItems()

// Try to load MDX content for this card
const cardEntries = await getCollection('handbookCards', entry => entry.id === `${sectionId}/${cardId}`)
const cardEntry = cardEntries[0]
if (!cardEntry) {
	throw new Error(`Missing canonical handbook content for ${sectionId}/${cardId}`)
}
const rendered = await render(cardEntry)
const CardContent = rendered.Content
const cardHeadings = rendered.headings
const cardTopic = getProductCardTopics(product).find(topic => topic.topicId === `${sectionId}/${cardId}`)!
const previousTopic = getPreviousTopic(cardTopic)
const nextTopic = getNextTopic(cardTopic)
const chapterCards = getProductCardTopics(product)
	.filter(topic => topic.parentTopicId === cardTopic.parentTopicId && topic.topicId !== cardTopic.topicId)
	.slice(0, 3)
---

<HandbookLayout
  title={card.title}
  description={card.description}
  sidebar={sidebar}
  currentId={`${sectionId}/${cardId}`}
  headings={card.id === 'separation-of-concerns' ? [] : cardHeadings}
  product={product}
>
  <nav class="flex items-center gap-2 text-sm text-[var(--color-fg-subtle)] mb-8">
    <a href="/handbook/" class="hover:text-[var(--color-fg)] transition-colors">Handbook</a>
    <span class="text-[var(--color-line-strong)]">/</span>
    <a href={`/handbook/${section.id}/`} class="hover:text-[var(--color-fg)] transition-colors">{section.title}</a>
    <span class="text-[var(--color-line-strong)]">/</span>
    <span class="text-[var(--color-fg)]">{card.title}</span>
  </nav>

  {card.id === 'separation-of-concerns' ? (
    <SocScrolly />
  ) : (
    <>
      <div class="mb-10">
        <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase mb-2" style={`color: var(--color-${section.color}-hi)`}>
          {section.title}
        </p>
        <h1 class="font-display font-semibold text-[1.85rem] tracking-tight mb-3" style="color: var(--color-fg-strong); line-height: 1.15">
          {card.title}
        </h1>
        <p class="lede max-w-[70ch]">
          {card.description}
        </p>
      </div>
      <CardContent />
    </>
  )}

  {chapterCards.length > 0 && (
    <section class="pt-8 border-t border-[var(--color-line)]">
      <h2 class="font-display font-semibold text-base text-[var(--color-fg)] mb-5">In this chapter</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {chapterCards.map((related) => (
          <HandbookCard
            title={related.title}
            description={related.description}
            icon={related.icon ?? 'help'}
            href={related.canonicalRoute}
            color={section.color}
          />
        ))}
      </div>
    </section>
  )}

  {(previousTopic || nextTopic) && (
    <section class="pt-8 border-t border-[var(--color-line)]">
      <div class="flex items-start justify-between gap-6 flex-wrap">
        {previousTopic && (
          <a href={previousTopic.canonicalRoute} class="group inline-flex items-center gap-2 text-sm">
            <span class="text-[var(--color-fg-subtle)]">←</span>
            <span class="font-display font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-found)] transition-colors">{previousTopic.title}</span>
          </a>
        )}
        {nextTopic && (
          <a href={nextTopic.canonicalRoute} class="group inline-flex items-center gap-2 text-sm ml-auto">
            <span class="font-display font-semibold text-[var(--color-fg)] group-hover:text-[var(--color-found)] transition-colors">{nextTopic.title}</span>
            <span class="text-[var(--color-fg-subtle)]">→</span>
          </a>
        )}
      </div>
    </section>
  )}
</HandbookLayout>
