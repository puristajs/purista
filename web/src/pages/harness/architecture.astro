---
import CTASection from '../../components/sections/CTASection.astro'
import HarnessFlow from '../../components/harness/HarnessFlow.astro'
import HarnessHero from '../../components/harness/HarnessHero.astro'
import HarnessStory from '../../components/harness/HarnessStory.astro'
import HarnessLayout from '../../layouts/HarnessLayout.astro'
---

<HarnessLayout title="Architecture | AI Harness | PURISTA" description="How the PURISTA AI Harness works: primitives, adapter model, agent lifecycle, durable execution, and observability.">

  <HarnessHero
    lines={[
      { text: 'In-process' },
      { text: 'runtime', color: 'found' },
      { text: 'for AI agents.' },
    ]}
    lede="The Harness is not a SaaS. It sits inside your application — between your TypeScript code and external model providers — providing typed boundaries, sandboxed execution, and full observability. Every piece is a pluggable adapter."
  />

  {/* ── Building Blocks ──────────────────────────────────────────── */}
  <section class="section-pad bg-[var(--color-bg-sunk)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Core Concepts</div>
        <h2 class="display display-lg">Eight building blocks</h2>
        <p class="lede">The Harness composes eight primitives into a single typed boundary. Each has a single responsibility and a defined interface.</p>
      </div>

      <div class="arch-blocks">
        <div class="arch-block">
          <span class="arch-block-label site-mono">Harness</span>
          <p>Compiled definition of models, tools, skills, agents, workflows, defaults, and adapters. The harness is the declaration of what capabilities exist in your system.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Session</span>
          <p>Isolated operational context with memory, history, sandbox, and one active run at a time. Answers: what user, thread, or tenant is this run for?</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Agent</span>
          <p>A typed LLM conversation loop. Prepares messages, calls the model, executes tools, appends results, validates output, and emits events.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Workflow</span>
			<p>Application-owned orchestration around one or more agent invocations. Sequence, branch, fan out, reflect, judge, create a review task, write state.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Tool</span>
          <p>Callable capability exposed to an agent: TypeScript, built-in, or MCP. Each tool has typed input/output, a timeout, and sandbox access.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Skill</span>
          <p>Mounted instruction directory with SKILL.md frontmatter. Reusable domain guidance that agents follow without code duplication or prompt embedding.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Memory</span>
          <p>Application-, tenant-, principal-, session-, run-, and agent-scoped JSON memory. A dependency-free in-memory engine is the default; dedicated engines add durable local or multi-instance persistence and retrieval.</p>
        </div>
        <div class="arch-block">
          <span class="arch-block-label site-mono">Harness Storage</span>
          <p>Conversation and run persistence plus optional checkpoint, lease, wait, and resume guarantees for long-running workflows. Recovery starts from the last committed checkpoint inside your application boundary. Streams remain observation-only.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Agent vs Workflow ─────────────────────────────────────────── */}
  <HarnessStory
    id="agent-vs-workflow"
    layout="viz-left"
    eyebrow="Composition Model"
    headline={[{ text: 'Stack agents' }, { text: 'into workflows.', color: 'con' }]}
		lede="An agent is one typed LLM conversation loop with its own tools, skills, and instructions — the smallest unit of AI reasoning. A workflow composes multiple agents into a named sequence with branching, fan-out, application-owned review tasks, and deterministic logic between each step. One workflow can run a research agent, hand off to a writing agent, and create a review task before a domain write — each with its own tools and skills, all coordinated by your application code."
    items={[
      'Agent: one typed LLM loop with tools, skills, and typed output',
      'Workflow: orchestrates one or more agents with full application control',
      'Fan-out: run multiple agents in parallel, synthesize results',
		'Human review: the application records the decision before the domain write',
      'Each agent in a workflow has its own instructions and tool set',
    ]}
  >
    <div slot="visualization" class="w-full">
      <HarnessFlow variant="agent-workflow" />
    </div>
  </HarnessStory>

  {/* ── Agent Lifecycle ───────────────────────────────────────────── */}
  <HarnessStory
    id="agent-lifecycle"
    layout="viz-right"
    eyebrow="Agent Lifecycle"
    headline={[{ text: 'Every step ' }, { text: 'is observable', color: 'found' }]}
    lede="From session creation through model calls, tool execution, and validation — every step emits run events and OpenTelemetry spans. Nothing is invisible."
    items={[
      'App calls session.agents.answerer.stream(input)',
      'Session creates a run and emits run.started',
      'Agent invokes the model with tool specs',
      'Model returns tool call or final object',
      'Tool executes with timeout and sandbox',
      'Validated output returned, run finished',
    ]}
  >
    <div slot="visualization" class="w-full">
      <HarnessFlow variant="agent-lifecycle" />
    </div>
  </HarnessStory>

  {/* ── Durable Execution ─────────────────────────────────────────── */}
  <HarnessStory
    id="durable"
    layout="viz-left"
    eyebrow="Durable Execution"
    headline={[{ text: 'Long runs.' }, { text: 'Survive restarts.', color: 'con' }]}
    lede="Persistent HarnessStorage adds checkpoints, leases, waits, and resume for long-running workflows. Recovery starts from the last committed step inside your application boundary, not from scratch or a hosted workflow engine. Streams remain observation-only."
    items={[
      'Checkpoint state locally at deterministic boundaries',
      'Lease management prevents duplicate execution',
      'Resume from last checkpoint on restart',
      'Declare requirements with .requires(["storage.checkpoint"])',
      'Streams are observation-only, not recovery cursors',
    ]}
  >
    <div slot="visualization" class="w-full">
      <HarnessFlow variant="durable-run" />
    </div>
  </HarnessStory>

  {/* ── Adapter Model ─────────────────────────────────────────────── */}
  <section class="section-pad bg-[var(--color-bg-sunk)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Adapter Model</div>
        <h2 class="display display-lg">Every boundary is pluggable</h2>
        <p class="lede">Models, sandbox, state, tools, skills, and MCP — each capability is an adapter with a defined interface. Pick the defaults. Replace them as requirements change. Add your own when nothing off-the-shelf fits.</p>
      </div>

      <div class="arch-adapters">
        <div class="arch-adapter">
          <div class="arch-adapter-head">
            <span class="arch-adapter-name site-mono">Model Provider</span>
          </div>
          <p>Translates harness requests to provider SDKs. Capability-gated — if the bound model can't provide a required feature, startup fails with a clear error, not a runtime surprise.</p>
						<p><a href="/handbook/harness/ecosystem-packages/#model-providers">Compare provider packages and minimal configuration →</a></p>
          <div class="arch-providers">
            <div class="arch-provider">
              <svg class="arch-provider-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="OpenAI"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.843-3.371 2.019-1.164a.076.076 0 0 1 .071 0l4.83 2.786a4.494 4.494 0 0 1-.676 8.105v-5.677a.79.79 0 0 0-.4-.679zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg>
              <div>
                <div class="arch-provider-name">OpenAI</div>
                <div class="arch-provider-pkg site-mono">@purista/harness-openai</div>
              </div>
            </div>
            <div class="arch-provider">
              <svg class="arch-provider-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="Anthropic"><path d="M17.304 3.541h-3.23L8.697 20.459h3.229l1.36-3.807h5.427l1.36 3.807H23.2zm-3.47 10.27 1.862-5.217 1.861 5.217zM5.527 3.541H.8l5.377 16.918h3.229z"/></svg>
              <div>
                <div class="arch-provider-name">Anthropic</div>
                <div class="arch-provider-pkg site-mono">@purista/harness-anthropic</div>
              </div>
            </div>
            <div class="arch-provider">
              <svg class="arch-provider-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="Amazon Web Services"><path d="M6.763 10.036c0 .296.032.535.088.71.064.176.144.368.256.576.04.063.056.127.056.183 0 .08-.048.16-.152.24l-.503.335a.383.383 0 0 1-.208.072c-.08 0-.16-.04-.239-.112a2.47 2.47 0 0 1-.287-.375 6.18 6.18 0 0 1-.248-.471c-.622.734-1.405 1.101-2.347 1.101-.67 0-1.205-.191-1.596-.574-.391-.384-.59-.894-.59-1.533 0-.678.239-1.23.726-1.644.487-.415 1.133-.623 1.955-.623.272 0 .551.024.846.064.296.04.6.104.918.176v-.583c0-.607-.127-1.030-.375-1.277-.255-.248-.686-.367-1.3-.367-.28 0-.568.031-.863.103-.295.072-.583.16-.862.272a2.287 2.287 0 0 1-.28.104.488.488 0 0 1-.127.023c-.112 0-.168-.08-.168-.247v-.391c0-.128.016-.224.056-.28a.597.597 0 0 1 .224-.167c.279-.144.614-.264 1.005-.36a4.84 4.84 0 0 1 1.246-.151c.95 0 1.644.216 2.091.647.439.43.662 1.085.662 1.963zm-3.24 1.214c.263 0 .534-.048.822-.144.287-.096.543-.271.758-.51.128-.152.224-.32.272-.512.047-.191.08-.423.08-.694v-.335a6.66 6.66 0 0 0-.735-.136 6.02 6.02 0 0 0-.75-.048c-.535 0-.926.104-1.19.32-.263.215-.39.518-.39.917 0 .375.095.655.295.846.191.2.47.296.838.296zm13.085.517c-.415 0-.83-.048-1.229-.143-.399-.096-.71-.2-.918-.32-.128-.071-.215-.151-.247-.223a.563.563 0 0 1-.048-.224v-.407c0-.167.064-.247.183-.247.048 0 .096.008.144.024.048.016.12.048.2.08.271.12.566.215.878.279.319.064.63.096.95.096.502 0 .894-.088 1.165-.264a.86.86 0 0 0 .415-.758.777.777 0 0 0-.215-.559c-.144-.151-.415-.287-.807-.415l-1.157-.36c-.583-.183-1.014-.454-1.277-.813a1.902 1.902 0 0 1-.4-1.158c0-.335.073-.63.216-.886.144-.255.335-.479.575-.654.24-.184.51-.32.83-.415.32-.096.655-.136 1.006-.136.175 0 .359.008.535.032.183.024.35.056.518.088.16.04.312.088.455.136.144.048.255.096.32.152a.667.667 0 0 1 .23.174c.056.072.08.16.08.272v.375c0 .168-.064.256-.184.256a.83.83 0 0 1-.303-.096 3.652 3.652 0 0 0-1.532-.311c-.455 0-.815.071-1.062.223-.248.152-.375.383-.375.71 0 .224.08.416.24.567.159.152.454.304.877.44l1.134.358c.574.184.99.44 1.237.767.247.327.367.702.367 1.117 0 .343-.072.655-.207.926-.144.272-.336.511-.583.703-.248.2-.543.343-.886.447-.36.111-.743.167-1.166.167zm-4.85-.028c-.144 0-.24-.024-.304-.08-.063-.048-.12-.16-.168-.311L9.586 5.55a1.398 1.398 0 0 1-.072-.32c0-.128.064-.2.191-.2h.783c.151 0 .255.025.31.08.065.048.113.16.16.312l1.342 5.284 1.245-5.284c.04-.16.088-.264.151-.312a.549.549 0 0 1 .32-.08h.638c.152 0 .256.025.32.08.063.048.12.16.151.312l1.261 5.348 1.381-5.348c.048-.16.104-.264.16-.312a.52.52 0 0 1 .311-.08h.743c.127 0 .2.065.2.2 0 .04-.009.08-.017.128a1.137 1.137 0 0 1-.056.2l-1.923 6.17c-.048.16-.104.263-.168.311a.51.51 0 0 1-.303.08h-.687c-.151 0-.255-.024-.32-.08-.063-.056-.119-.16-.15-.32l-1.238-5.148-1.23 5.14c-.04.16-.087.264-.15.32-.065.056-.177.08-.32.08zm9.337 3.44c-2.626 1.94-6.442 2.97-9.722 2.97-4.598 0-8.74-1.7-11.87-4.526-.247-.223-.025-.527.27-.351 3.384 1.963 7.559 3.152 11.877 3.152 2.914 0 6.114-.607 9.06-1.852.439-.2.814.287.385.607zm1.103-1.253c-.337-.432-2.22-.204-3.069-.103-.256.031-.296-.192-.065-.36 1.502-1.056 3.967-.751 4.254-.397.288.355-.079 2.82-1.487 3.996-.217.183-.424.085-.328-.155.317-.79 1.032-2.55.695-2.981z"/></svg>
              <div>
                <div class="arch-provider-name">Amazon Bedrock</div>
                <div class="arch-provider-pkg site-mono">@purista/harness-bedrock</div>
              </div>
            </div>
            <div class="arch-provider">
              <svg class="arch-provider-icon" viewBox="0 0 24 24" fill="currentColor" aria-label="Microsoft Azure"><path d="M13.05 4.24L6.56 18.05l-1.49.35L11.86.5zm.38.17L24 19.72h-4.3l-2.85-6.29-5.15 6.01-6.49.47L14.73 9.5z"/></svg>
              <div>
                <div class="arch-provider-name">Azure AI Foundry</div>
                <div class="arch-provider-pkg site-mono">@purista/harness-azure-foundry</div>
              </div>
            </div>
          </div>
        </div>

        <div class="arch-adapter">
          <div class="arch-adapter-head">
            <span class="arch-adapter-name site-mono">Sandbox</span>
          </div>
          <p>File operations, command execution, and MCP server isolation. Choose in-memory for most agents. Add bash execution only where required. Build container or remote adapters for strict isolation policies.</p>
          <ul class="arch-adapter-list">
            <li><code class="site-mono" style="font-size:0.82em">inMemorySandbox()</code> — file ops only, no command execution</li>
            <li><code class="site-mono" style="font-size:0.82em">bashSandbox()</code> — command execution, higher privilege</li>
            <li>Custom adapters for containers or remote execution</li>
          </ul>
        </div>

        <div class="arch-adapter">
          <div class="arch-adapter-head">
            <span class="arch-adapter-name site-mono">Harness Storage</span>
          </div>
          <p>Persists sessions, run history, messages, and events across process restarts. Use the default for development. Use a durable adapter in production so run history and traces survive deployment cycles.</p>
          <ul class="arch-adapter-list">
            <li>In-memory default — suitable for local development</li>
            <li>Custom adapter — implement <code class="site-mono" style="font-size:0.82em">HarnessStorage</code> against any backend (Redis, Postgres, etc.)</li>
            <li>Any adapter that satisfies the typed <code class="site-mono" style="font-size:0.82em">HarnessStorage</code> port compiles in without changes to agent or workflow code</li>
          </ul>
        </div>

        <div class="arch-adapter">
          <div class="arch-adapter-head">
            <span class="arch-adapter-name site-mono">MCP Tools</span>
          </div>
          <p>Connect to any Model Context Protocol server. Stdio runs through the sandbox executor. HTTP calls remote endpoints. Both sides validate schemas before registering tools to the agent.</p>
						<p><a href="/handbook/harness/ecosystem-packages/">Browse every first-party Harness package and optional dependency →</a></p>
          <ul class="arch-adapter-list">
            <li><code class="site-mono" style="font-size:0.82em">mcp_stdio</code> — local server through sandbox executor</li>
            <li><code class="site-mono" style="font-size:0.82em">mcp_http</code> — remote endpoint over HTTP</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── Events & Observability ────────────────────────────────────── */}
  <section class="section-pad soft-gradient">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Observability</div>
        <h2 class="display display-lg">Every run is visible</h2>
        <p class="lede">All streaming APIs emit typed run events. Applications render these in chat UIs, run inspectors, logs, or tests. OpenTelemetry spans provide distributed tracing aligned to the GenAI semantic conventions.</p>
      </div>

      <div class="arch-events">
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">run.started</span>
          <span class="arch-event-desc">Session created a run for the agent or workflow invocation</span>
        </div>
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">agent.started</span>
          <span class="arch-event-desc">Agent reasoning loop began; model call is being prepared</span>
        </div>
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">tool.started</span>
          <span class="arch-event-desc">Tool invocation began with validated input; sandbox timer running</span>
        </div>
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">tool.finished</span>
          <span class="arch-event-desc">Tool returned; output validated and appended to conversation</span>
        </div>
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">agent.finished</span>
          <span class="arch-event-desc">Agent reasoning loop complete; output validated against output schema</span>
        </div>
        <div class="arch-event-row">
          <span class="arch-event-name site-mono">run.finished</span>
          <span class="arch-event-desc">Run completed or failed; final typed output or normalized error returned</span>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline={[{ text: 'See it ' }, { text: 'in practice', color: 'found' }, { text: '.' }]}
		lede="Explore production AI patterns — RAG, triage, application-owned review, parallel agents — then layer on memory adapters for context that persists across sessions."
    ctas={[
      { label: 'Use Cases', href: '/harness/use-cases/', variant: 'primary' },
      { label: 'Memory & Context', href: '/harness/memory/', variant: 'ghost' },
    ]}
  />

</HarnessLayout>

<style is:global>
  /* ── Building blocks: editorial definition list ── */
  .arch-blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  @media (max-width: 640px) { .arch-blocks { grid-template-columns: 1fr; } }

  .arch-block {
    padding: clamp(1.2rem, 2vw, 1.6rem) clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }
  .arch-block-label {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--color-found-hi);
    margin-bottom: 0.5rem;
  }
  .arch-block p {
    color: var(--color-fg-muted);
    font-size: 0.92rem;
    line-height: 1.58;
  }

  /* ── Adapter list: editorial rows ── */
  .arch-adapters {
    border-top: 1px solid var(--color-line);
  }
  .arch-adapter {
    padding: clamp(1.4rem, 2.5vw, 2rem) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .arch-adapter-head {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 0.75rem;
  }
  .arch-adapter-name {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--color-con-hi);
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
  .arch-adapter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .arch-adapter p {
    color: var(--color-fg-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    max-width: 80ch;
  }

  /* ── Event timeline ── */
  .arch-events {
    border-top: 1px solid var(--color-line);
    max-width: 860px;
  }
  .arch-event-row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    align-items: baseline;
  }
  @media (max-width: 600px) {
    .arch-event-row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  .arch-event-name {
    font-size: 0.8rem;
    color: var(--color-found-hi);
    letter-spacing: 0.04em;
  }
  .arch-event-desc {
    color: var(--color-fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* ── Provider grid ── */
  .arch-providers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  @media (max-width: 500px) { .arch-providers { grid-template-columns: 1fr; } }

  .arch-provider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }
  .arch-provider-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-fg-muted);
  }
  .arch-provider-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-fg);
    line-height: 1.2;
  }
  .arch-provider-pkg {
    font-size: 0.72rem;
    color: var(--color-fg-subtle);
    margin-top: 0.1rem;
  }

  /* ── Adapter inline list ── */
  .arch-adapter-list {
