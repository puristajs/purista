---
import CTASection from '../../components/sections/CTASection.astro'
import HarnessHero from '../../components/harness/HarnessHero.astro'
import CodeBlock from '../../components/ui/CodeBlock.astro'
import HarnessLayout from '../../layouts/HarnessLayout.astro'
---

<HarnessLayout
  title="Memory | AI Harness | PURISTA"
  description="Scoped, typed agent memory for PURISTA AI Harness: local defaults, durable engines, identity isolation, and optional semantic recall."
>
  <HarnessHero
    lines={[
      { text: 'Memory that stays' },
      { text: 'in the right scope.', color: 'found' },
    ]}
    lede="PURISTA AI Harness separates conversation state from durable recall. Core owns identity, scope validation, traces, and model-backed indexing; you choose the storage engine that fits the deployment."
  />

  <section class="section-pad bg-[var(--color-bg-sunk)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Two distinct responsibilities</div>
        <h2 class="display display-lg">Conversation state is not agent memory</h2>
        <p class="lede">HarnessStorage persists the conversation, runs, checkpoints, and approval waits. Memory holds application facts and recall that an agent, tool, skill, or workflow deliberately reads or updates.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="memory-panel">
          <div class="eyebrow mb-3" style="color: var(--color-found-hi)">HarnessStorage</div>
          <h3 class="h3 mb-3">The durable operational record</h3>
          <p>Messages, run lifecycle, resumable workflows, external waits, approvals, and checkpoints. Choose a regular Harness storage backend for the deployment.</p>
        </div>
        <div class="memory-panel">
          <div class="eyebrow mb-3" style="color: var(--color-con-hi)">MemoryEngine</div>
          <h3 class="h3 mb-3">Scoped facts and recall</h3>
          <p>Typed JSON records, TTL, and optional text or semantic retrieval. Memory is never model-visible unless the application includes it in a prompt or tool result.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Safe by construction</div>
        <h2 class="display display-lg">Identity determines the namespace</h2>
        <p class="lede">Tenant and principal are optional, but their presence and values are bound when a session opens. A mismatched reopen fails before a sandbox, model, memory engine, or run starts.</p>
      </div>
      <div class="scope-grid">
        {[
          ['application', 'Shared application facts'],
          ['tenant()', 'Shared tenant workspace'],
          ['principal()', 'One account within an optional tenant'],
          ['session', 'One conversation'],
          ['run', 'Transient work for one execution'],
          ['agent', 'One agent inside a session'],
        ].map(([scope, description]) => (
          <div class="scope-card">
            <code class="site-mono">{scope}</code>
            <span>{description}</span>
          </div>
        ))}
      </div>
      <CodeBlock
        code={`const session = await harness.getSession('claim:42', {
  tenantId: 'acme-insurance',
  principalId: 'adjuster:ada',
})

await session.memory.write('locale', 'de-DE')

// in an agent, workflow, tool, or skill context
await ctx.memory.principal().write('claim-summary', claim, {
  index: { text: claim.description },
  tags: ['claim', 'open'],
})`}
        label="Bind identity once, then select the intended lifetime"
        language="typescript"
      />
    </div>
  </section>

  <section class="section-pad bg-[var(--color-bg-sunk)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Choose the smallest engine</div>
        <h2 class="display display-lg">One API, four deployment paths</h2>
        <p class="lede">No configuration uses a dependency-free, process-local in-memory engine. Add a first-party package only when retention, sharing, or retrieval requires it.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Engine</th><th>Designed for</th><th>Recall</th><th>Deployment boundary</th></tr></thead>
          <tbody>
            <tr><td>In-memory</td><td>Tests, local development, one process</td><td>KV, list, TTL</td><td>No package or backend</td></tr>
            <tr><td>SQLite</td><td>Local durable applications</td><td>FTS5; optional exact vectors</td><td>One file; optional <code>sqlite-vec</code></td></tr>
            <tr><td>PostgreSQL</td><td>Shared relational production deployments</td><td>Text, semantic, hybrid</td><td>PostgreSQL 16+ with pgvector</td></tr>
            <tr><td>Redis</td><td>Low-latency shared recall</td><td>Text; optional semantic and hybrid</td><td>Redis 8+ with Search</td></tr>
            <tr><td>NATS</td><td>Existing JetStream KV deployments</td><td>KV, list, TTL</td><td>JetStream; deliberately no search</td></tr>
          </tbody>
        </table>
      </div>
      <CodeBlock
        code={`import { sqliteMemoryEngine } from '@purista/harness-memory-sqlite'

const harness = defineHarness({ name: 'claims-review' })
  .memory(sqliteMemoryEngine({ file: '.purista/memory.sqlite' }))
  .requires(['memory.persistent'])
  // models, tools, agents, workflows
  .build()`}
        label="A durable local composition"
        language="typescript"
      />
      <p class="memory-note">SQLite has no required third-party runtime dependency. Exact local vectors are an explicit <code>sqlite-vec@0.1.9</code> opt-in. PostgreSQL, Redis, and NATS each live in their own package; Dapr is intentionally not a supported memory backend.</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Optional model work, visible in operations</div>
        <h2 class="display display-lg">Semantic recall stays provider-neutral</h2>
        <p class="lede">Only an engine with vector capability can use a typed embedding alias. A summary alias is separately optional. TypeScript rejects incompatible aliases before deployment, and the Harness validates the same constraint at build time.</p>
      </div>
      <CodeBlock
        code={`const harness = defineHarness({ name: 'knowledge-assistant' })
  .models({
    memoryEmbedding: { provider, model: 'embed-v1', capabilities: ['embeddings'] },
    memorySummary: { provider, model: 'summary-v1', capabilities: ['object'] },
  })
  .memory((model) => ({
    engine: vectorMemoryEngine,
    embedding: model.memoryEmbedding,
    summary: model.memorySummary,
  }))
  .build()`}
        label="Capabilities drive autocomplete and type checking"
        language="typescript"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="memory-panel"><h3 class="h3 mb-2">Traceable</h3><p><code>harness.memory.*</code> spans show each operation without memory content. The nested model span contains provider, model, available token usage, and cost attributes once.</p></div>
        <div class="memory-panel"><h3 class="h3 mb-2">Fail-closed</h3><p>An explicit text, semantic, or hybrid request fails when its engine capability is absent. The system never quietly changes retrieval mode.</p></div>
        <div class="memory-panel"><h3 class="h3 mb-2">Testable</h3><p>Use the in-memory engine for deterministic unit tests and <code>memoryEngineContract</code> for a custom or backend-specific engine.</p></div>
      </div>
    </div>
  </section>

  <CTASection
    headline={[{ text: 'Build the right' }, { text: ' memory boundary.', color: 'found' }]}
    lede="The handbook has setup, capability matrices, engine-specific examples, operation details, and production guidance."
    ctas={[
      { label: 'Memory guide', href: '/handbook/harness/memory/', variant: 'primary' },
      { label: 'All Harness packages', href: '/handbook/harness/ecosystem-packages/', variant: 'ghost' },
      { label: 'Observability', href: '/harness/observability/', variant: 'ghost' },
    ]}
  />
</HarnessLayout>

<style>
  .memory-panel { padding: 1.5rem; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-bg); }
  .memory-panel p, .memory-note { margin: 0; color: var(--color-fg-muted); }
  .scope-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-left: 1px solid var(--color-line); border-top: 1px solid var(--color-line); margin-bottom: 2rem; }
  .scope-card { display: flex; min-height: 6.5rem; flex-direction: column; justify-content: space-between; gap: .75rem; padding: 1.25rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .scope-card code { color: var(--color-found-hi); font-weight: 700; }
  .scope-card span { color: var(--color-fg-muted); font-size: .9rem; }
  .table-wrap { overflow-x: auto; margin-bottom: 2rem; border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }
  th, td { padding: 1rem; border-bottom: 1px solid var(--color-line); vertical-align: top; }
  th { color: var(--color-fg); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; }
  td { color: var(--color-fg-muted); font-size: .92rem; }
  tr:last-child td { border-bottom: 0; }
  .memory-note { margin-top: 1rem; font-size: .9rem; }
  @media (max-width: 760px) { .scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .scope-grid { grid-template-columns: 1fr; } }
</style>
