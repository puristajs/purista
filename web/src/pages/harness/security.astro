---
import CTASection from '../../components/sections/CTASection.astro'
import HarnessFlow from '../../components/harness/HarnessFlow.astro'
import HarnessHero from '../../components/harness/HarnessHero.astro'
import HarnessStory from '../../components/harness/HarnessStory.astro'
import SecurityBoundary from '../../components/harness/SecurityBoundary.astro'
import HarnessLayout from '../../layouts/HarnessLayout.astro'
---

<HarnessLayout title="Security & Production Readiness | AI Harness | PURISTA" description="Sandboxed execution, application-owned review, content policies, and a production checklist for deploying the AI Harness.">

  <HarnessHero
    lines={[
      { text: 'Secure by' },
      { text: 'design,', color: 'con' },
      { text: 'not by accident.' },
    ]}
    lede="The Harness treats security as infrastructure, not an afterthought. Sandboxed execution, application-owned review, content capture disabled by default, and a clear production checklist."
  />

  {/* ── The boundary that matters ─────────────────────────────────── */}
  <HarnessStory
    id="in-process"
    layout="viz-right"
    eyebrow="Security Architecture"
    headline={[{ text: 'Security follows ' }, { text: 'declared boundaries.', color: 'con' }]}
    lede="The Harness runs in your application composition root and opens a session-owned sandbox through an adapter. Typed schemas, explicit tools, lifecycle control, and content-safe diagnostics reduce exposure. The selected adapter and its platform—not the word sandbox—enforce process, filesystem, network, identity, and resource isolation."
    items={[
      'The application owns caller identity, domain authorization, secret delivery, tenancy, and business side effects.',
      'Schemas validate model and tool data shapes; they do not grant access or make a remote service safe.',
      'Files-only is the default. Command execution and long-lived processes require an explicit adapter capability.',
      'Secrets stay protected only when the application and platform do not mount or inject them into model-reachable paths.',
    ]}
  >
    <div slot="visualization" class="w-full">
      <SecurityBoundary />
    </div>
  </HarnessStory>

  {/* ── Security Pillars ─────────────────────────────────────────── */}
  <section class="section-pad soft-gradient">
    <div class="wrap">
      <div class="section-head--center mb-12">
        <div class="eyebrow">Security Model</div>
        <h2 class="display display-lg">Four pillars of safe AI</h2>
      </div>
      <div class="sec-pillars">
        <div class="sec-pillar">
          <span class="sec-pillar-label site-mono">Sandboxed Execution</span>
          <p>Each Harness session receives an adapter-owned filesystem and optional execution boundary. The platform must enforce any stronger isolation, egress, process identity, and resource limits.</p>
          <ul class="sec-pillar-list">
            <li>inMemorySandbox() — file-only, no command execution</li>
            <li>bashSandbox() — in-process execution helper, not a VM or container</li>
            <li>Declared skills mount under /skills/&lt;name&gt; and are read on demand</li>
            <li>Custom adapters for containers, microVMs, or remote execution</li>
            <li>Explicit filesystem, exec, spawn, and lifecycle capabilities</li>
          </ul>
        </div>
        <div class="sec-pillar">
          <span class="sec-pillar-label site-mono">Human-in-the-Loop</span>
          <p>No mutation before approval. Harness returns a durable interruption for a gated tool call. The application creates and authorizes the review, then resumes the same run with the typed decision.</p>
          <ul class="sec-pillar-list">
            <li>Application-owned reviewer identity, questions, and task UI</li>
            <li>Application-owned stale-decision, expiry, and idempotency checks</li>
            <li>Typed approval interruption and resume contracts for tool controls</li>
            <li>Governance policy and approval events for audit</li>
            <li>Domain authorization and transaction checks remain mandatory</li>
          </ul>
        </div>
        <div class="sec-pillar">
          <span class="sec-pillar-label site-mono">Content Privacy</span>
          <p>Content capture is disabled by default. Prompts and responses are not persisted in traces or logs unless explicitly enabled for local diagnostics.</p>
          <ul class="sec-pillar-list">
            <li>contentCaptureMode: 'NO_CONTENT' by default</li>
            <li>Enable only for deliberate local diagnostics</li>
            <li>OTel spans include metadata, not content</li>
            <li>Application owns data residency decisions</li>
          </ul>
        </div>
        <div class="sec-pillar">
          <span class="sec-pillar-label site-mono">Type Safety & Validation</span>
          <p>Every agent input, output, and tool call is schema-validated. No unvalidated data flows from the model to your application code.</p>
          <ul class="sec-pillar-list">
            <li>Zod schemas for all inputs and outputs</li>
            <li>TypeScript inference through the entire chain</li>
            <li>Tool input/output validation with normalized errors</li>
            <li>MCP schema validation before tool registration</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── Sandbox Detail ───────────────────────────────────────────── */}
  <HarnessStory
    id="sandbox"
    layout="viz-left"
    eyebrow="Sandbox"
    headline={[{ text: 'Controlled ' }, { text: 'execution', color: 'con' }]}
    lede="Choose the smallest runtime boundary that meets the task. The built-ins are excellent files-only and trusted-development defaults; an enterprise command or stdio workload needs an isolating adapter and a platform policy you can test."
    items={[
      'inMemorySandbox() — file operations, no commands',
      'bashSandbox() — trusted in-process command helper; no stdio-process hosting',
      'Skills are mounted as files and the prompt lists only metadata plus /skills/<name>/SKILL.md',
      'Custom Sandbox/SandboxSession for a container, microVM, or remote runner',
      'Platform-enforced mounts, egress, identity, quotas, and cleanup for command-capable work',
      'Snapshot, resume, and hibernate capabilities opt-in',
      'Preview ports and browser routing stay application-owned',
    ]}
  >
    <div slot="visualization" class="w-full">
      <HarnessFlow variant="sandbox" />
      <p class="mt-5 text-sm leading-relaxed text-[var(--color-fg-muted)]">
        The developer guide covers the threat model, exact built-in limits, MCP and Agent Plugin constraints, adapter contract, and negative-test baseline:
        <a class="text-[var(--color-con)] underline underline-offset-4" href="/handbook/harness/secure-and-govern/sandbox-and-mcp/">Sandboxing &amp; MCP</a>.
      </p>
    </div>
  </HarnessStory>

  {/* ── Application review ───────────────────────────────────────── */}
  <HarnessStory
    id="review-gate"
    layout="viz-right"
    eyebrow="Application Review"
    headline={[
      { text: 'No mutations ' },
      { text: 'without approval', color: 'found' },
    ]}
    lede="When an agent proposes a change, the application stores an authenticated review task and exposes it through its normal UI or transport. The application verifies the decision before it invokes the domain write."
    items={[
      'Proposal agent drafts the change',
      'Workflow records a typed proposal and review reference',
      'Application UI and identity provider collect a decision',
      'Application validates task version, authorization, and idempotency',
      'Domain write runs only after an approved decision',
      'Governance can add a separate immediate tool control',
      'All selected lifecycle signals are traced and logged',
    ]}
  >
    <div slot="visualization" class="w-full">
      <HarnessFlow variant="review" />
    </div>
  </HarnessStory>

  {/* ── Production Checklist ─────────────────────────────────────── */}
  <section class="section-pad bg-[var(--color-bg-sunk)] border-y border-[var(--color-line)]">
    <div class="wrap">
      <div class="section-head--center mb-16">
        <div class="eyebrow">Production Checklist</div>
        <h2 class="display display-lg">Eight decisions before go-live</h2>
        <p class="lede">
          Each item is a boundary. Get it right once, and every agent you build inherits the safety.
        </p>
      </div>

      <div class="sec-checklist">
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">01</span>
          <div>
            <div class="sec-check-title">Durable HarnessStorage</div>
            <p>Use a durable adapter so sessions, run history, and OTel traces survive process restart. In-memory state is fine for local development. Production needs persistence.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">02</span>
          <div>
            <div class="sec-check-title">Tenant-safe Session IDs</div>
            <p>Scope session, state, and workspace records to the tenant, but do not mistake an ID such as <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">tenant-a:user-42</code> for access control. Enforce authorization and per-tenant workspace lifecycle in the application and storage platform.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">03</span>
          <div>
            <div class="sec-check-title">Explicit Timeout Budgets</div>
            <p>Set <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">runTimeoutMs</code>, <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">modelTimeoutMs</code>, and <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">toolTimeoutMs</code> for each path. User-facing routes get smaller budgets. Background research gets larger ones.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">04</span>
          <div>
            <div class="sec-check-title">Content Capture Off</div>
            <p>Keep <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">contentCaptureMode: 'NO_CONTENT'</code> outside local diagnostics. Never log PII, secrets, or model prompts in production traces. OTel spans include metadata, not content.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">05</span>
          <div>
            <div class="sec-check-title">Permission and Governance Gates</div>
            <p>Use an application-owned review task, explicit permission checks, or opt-in Harness governance before sensitive tools. No write should happen without domain authorization, an idempotent transaction boundary, and an enforced policy where required.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">06</span>
          <div>
            <div class="sec-check-title">Minimal Sandbox Permissions</div>
            <p>Use <code class="site-mono" style="font-size:0.82em;background:var(--color-bg);padding:0 0.3em;border-radius:3px">inMemorySandbox()</code> unless command execution is explicitly required. For commands or stdio MCP, use a custom adapter whose platform enforces mounts, egress, unprivileged identity, CPU/memory/PID limits, and cleanup; local host execution is not that boundary.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">07</span>
          <div>
            <div class="sec-check-title">Test Failure Modes</div>
            <p>Test provider failures, validation failures, cancellation mid-run, and graceful shutdown paths. The Harness provides test harnesses and scripted models for deterministic failure simulation.</p>
          </div>
        </div>
        <div class="sec-check-row">
          <span class="sec-check-num site-mono">08</span>
          <div>
            <div class="sec-check-title">Validate Tool Outputs</div>
            <p>Never trust model-generated tool inputs. The Harness validates with Zod before execution, but your tool handler should also defend against edge cases. Return structured data. Respect signals.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline={[
      { text: 'Build AI that ' },
      { text: 'your team trusts', color: 'con' },
      { text: '.' },
    ]}
    lede="The Harness gives you the structure, safety, and observability that enterprise AI requires — without the SaaS lock-in."
    ctas={[
      {
        label: 'Get started',
        href: '/harness/get-started/',
        variant: 'primary',
      },
      {
        label: 'Explore Use Cases',
        href: '/harness/use-cases/',
        variant: 'ghost',
      },
    ]}
  />
</HarnessLayout>

<style is:global>
  /* ── Security pillars: 2-col border-grid ── */
  .sec-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  @media (max-width: 640px) { .sec-pillars { grid-template-columns: 1fr; } }

  .sec-pillar {
    padding: clamp(1.2rem, 2vw, 1.6rem) clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }
  .sec-pillar-label {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--color-con-hi);
    margin-bottom: 0.5rem;
  }
  .sec-pillar p {
    color: var(--color-fg-muted);
    font-size: 0.92rem;
    line-height: 1.58;
    margin-bottom: 0.75rem;
  }
  .sec-pillar-list {
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .sec-pillar-list li {
    color: var(--color-fg-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .sec-pillar-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-found);
    font-size: 0.75rem;
    top: 0.1em;
  }

  /* ── Production checklist: numbered editorial rows ── */
  .sec-checklist {
    border-top: 1px solid var(--color-line);
    max-width: 860px;
    margin: 0 auto;
  }
  .sec-check-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-line);
    align-items: baseline;
  }
  @media (max-width: 600px) {
    .sec-check-row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  .sec-check-num {
    font-size: 0.75rem;
    color: var(--color-found-hi);
    letter-spacing: 0.08em;
    padding-top: 0.1rem;
  }
  .sec-check-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.4rem;
  }
  .sec-check-row p {
    color: var(--color-fg-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
