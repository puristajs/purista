---
import Nav from '../components/landing/Nav.astro'
import type { PrimaryNavKey } from '../data/navigation'
import type { SidebarItem } from '../lib/sidebar'
import BaseLayout from './BaseLayout.astro'
import '../styles/site.css'

interface Props {
	title: string
	description?: string
	sidebar?: SidebarItem[]
	currentId?: string
	headings?: { depth: number; slug: string; text: string }[]
	prose?: boolean
	/** Name shown in browser titles and the responsive navigation control. */
	sectionTitle?: string
	/** Root route for the current documentation section, without a trailing slash. */
	sectionRoot?: string
	active?: PrimaryNavKey
}

const {
	title,
	description,
	sidebar = [],
	currentId = '',
	headings = [],
	prose = true,
	sectionTitle = 'Handbook',
	sectionRoot = '/handbook',
	active = 'handbook',
} = Astro.props
const sectionHomeTitle = `PURISTA ${sectionTitle}`
const pageTitle = title === sectionHomeTitle ? title : `${title} | ${sectionHomeTitle}`
const sectionPath = Astro.url.pathname.replace(/\/$/, '')
const markdownUrl = sectionPath === sectionRoot ? `${sectionRoot}.md` : `${sectionPath}.md`
function isActive(item: SidebarItem, id: string): boolean {
	const itemBase = item.id.replace(/\/index$/, '')
	const currentBase = id.replace(/\/index$/, '')
	return itemBase === currentBase
}

function isParentActive(item: SidebarItem, id: string): boolean {
	if (!item.items) return false
	const itemBase = item.id.replace(/\/index$/, '')
	const currentBase = id.replace(/\/index$/, '')
	// Direct path prefix match
	if (currentBase.startsWith(itemBase + '/') || itemBase === currentBase) return true
	// Also match if current page is one of the nested items
	return item.items.some(sub => {
		const subBase = sub.id.replace(/\/index$/, '')
		if (subBase === currentBase) return true
		if (sub.items) return isParentActive(sub, id)
		return false
	})
}

function getItemHref(item: SidebarItem): string {
	if (item.href) return item.href
	const base = item.id.replace(/\/index$/, '')
	if (base === '') return `${sectionRoot}/`
	return `${sectionRoot}/${base}`
}
---

<BaseLayout title={pageTitle} description={description} siteShell markdownUrl={markdownUrl}>
  <Nav active={active} />

  <div class="h-screen flex flex-col overflow-hidden pt-[72px]">
  {/* The desktop tree is intentionally hidden below `lg`; keep its first
      actionable level available through a compact, native disclosure instead
      of stranding readers at the Handbook landing page on a narrow screen. */}
  <details class="lg:hidden shrink-0 border-b border-[var(--color-line)] bg-[var(--color-bg)]">
    <summary class="cursor-pointer px-6 py-3 font-display text-sm font-semibold text-[var(--color-fg-strong)]">
      Browse {sectionTitle.toLowerCase()} topics
    </summary>
    <nav aria-label={`${sectionTitle} navigation`} class="max-h-[55vh] overflow-y-auto border-t border-[var(--color-line)] px-5 py-4">
      {sidebar.map((item) => (
        item.kind === 'sectionHeader' ? (
          <a href={getItemHref(item)} class={`block px-1 pb-2 pt-4 text-xs font-semibold uppercase tracking-wide text-[var(--color-fg-strong)] ${item.sectionStart ? 'border-t border-[var(--color-line)]' : 'pt-0'}`}>
            {item.title}
          </a>
        ) : (
          <div class="pb-3">
            <a href={getItemHref(item)} class={`block py-1 text-sm font-semibold ${isActive(item, currentId) ? 'text-[var(--color-found)]' : 'text-[var(--color-fg-strong)]'}`}>
              {item.title}
            </a>
            {item.items && item.items.length > 0 && isParentActive(item, currentId) && (
              <div class="border-l border-[var(--color-line)] pl-3">
                {item.items.map((sub) => (
                  <div>
                    <a href={getItemHref(sub)} class={`block py-1 text-sm leading-snug ${isActive(sub, currentId) ? 'text-[var(--color-found)]' : isParentActive(sub, currentId) ? 'text-[var(--color-fg-strong)]' : 'text-[var(--color-fg-muted)]'}`}>
                      {sub.title}
                    </a>
                    {sub.items && sub.items.length > 0 && isParentActive(sub, currentId) && (
                      <div class="border-l border-[var(--color-line)] pl-3">
                        {sub.items.map((subsub) => (
                          <a href={getItemHref(subsub)} class={`block py-1 text-sm leading-snug ${isActive(subsub, currentId) ? 'text-[var(--color-found)]' : 'text-[var(--color-fg-muted)]'}`}>
                            {subsub.title}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      ))}
    </nav>
  </details>

    <div class="flex flex-1 min-h-0 overflow-hidden">
      {/* Sidebar */}
      <aside class="hidden lg:block w-64 shrink-0 border-r border-[var(--color-line)] overflow-y-auto" style="background: var(--color-bg)">
        <div class="px-4 py-6">
          <nav class="space-y-0.5">
            {sidebar.map((item) => (
              item.kind === 'sectionHeader' ? (
                <div class:list={['mb-5', { 'pt-7 mt-7 border-t border-[var(--color-line)]': item.sectionStart }]}>
                  <a href={getItemHref(item)} class="flex items-center gap-2.5 px-2 group">
                    <div class="w-6 h-6 grid place-items-center bg-[var(--color-fg)] text-[var(--color-bg)] rounded text-[0.55rem] font-extrabold font-display tracking-[-0.08em] shrink-0 group-hover:bg-[var(--color-found)] transition-colors">
                      {item.iconLabel}
                    </div>
                    <span class="font-display font-semibold text-sm tracking-tight group-hover:text-[var(--color-found)] transition-colors" style="color: var(--color-fg-strong)">{item.title}</span>
                  </a>
                </div>
              ) : (
                <div class="hbl-group">
                  <a
                    href={getItemHref(item)}
                    class={`hbl-item ${
                      isActive(item, currentId)
                        ? 'hbl-item--active'
                        : isParentActive(item, currentId)
                        ? 'hbl-item--parent'
                        : 'hbl-item--default'
                    }`}
                  >
                    {item.title}
                  </a>
                  {item.items && item.items.length > 0 && isParentActive(item, currentId) && (
                    <div class="hbl-children">
                      {item.items.map((sub) => (
                        <div>
                          <a
                            href={getItemHref(sub)}
                            class={`hbl-item hbl-item--sub ${
                              isActive(sub, currentId)
                                ? 'hbl-item--active'
                                : isParentActive(sub, currentId)
                                ? 'hbl-item--parent'
                                : 'hbl-item--default'
                            }`}
                          >
                            {sub.title}
                          </a>
                          {sub.items && sub.items.length > 0 && isParentActive(sub, currentId) && (
                            <div class="hbl-children">
                              {sub.items.map((subsub) => (
                                <a
                                  href={getItemHref(subsub)}
                                  class={`hbl-item hbl-item--sub ${
                                    isActive(subsub, currentId)
                                      ? 'hbl-item--active'
                                      : 'hbl-item--default'
                                  }`}
                                >
                                  {subsub.title}
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )
            ))}
          </nav>
        </div>
      </aside>

      {/* Main content */}
      <main class="flex-1 min-w-0 overflow-y-auto">
        <div class="max-w-5xl mx-auto px-6 py-12 lg:py-16">
          <article class:list={[{ prose }]}>
            <slot />
          </article>
        </div>
      </main>

      {/* TOC - Right sidebar */}
      {headings.length > 0 && (
        <aside class="hidden xl:block w-56 shrink-0 border-l border-[var(--color-line)] overflow-y-auto" style="background: var(--color-bg)">
          <div class="px-4 py-6 sticky top-0">
            <div class="font-mono text-[0.65rem] tracking-[0.14em] uppercase font-semibold mb-3" style="color: var(--color-fg-subtle)">On this page</div>
            <nav class="space-y-0.5">
              {headings.filter((h) => h.depth <= 3).map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`block py-1 text-[0.78rem] leading-snug transition-colors hover:text-[var(--color-found)] ${
                    heading.depth === 2
                      ? 'text-[var(--color-fg-muted)]'
                      : 'text-[var(--color-fg-subtle)] pl-3 border-l border-[var(--color-line)]'
                  }`}
                  style="font-family: var(--font-display); text-decoration: none;"
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </div>

  <script>
    import '../scripts/handbook-client.ts';
  </script>
</BaseLayout>
