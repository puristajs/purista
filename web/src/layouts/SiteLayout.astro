---
import HarnessNav from '../components/ui/HarnessNav.astro'
import Footer from '../components/landing/Footer.astro'
import Nav from '../components/landing/Nav.astro'
import type { PrimaryNavKey } from '../data/navigation'
import BaseLayout from './BaseLayout.astro'
import '../styles/site.css'

interface Props {
	title?: string
	description?: string
	active?: PrimaryNavKey
}

const {
	title = 'PURISTA — Production-grade by structure.',
	description = 'PURISTA is the open-source TypeScript framework that turns AI-built software into approval-ready enterprise systems.',
	active = 'home',
} = Astro.props
const sitePath = Astro.url.pathname.replace(/\/$/, '')
const markdownUrl = active === 'harness' ? (sitePath === '/harness' ? '/harness.md' : `${sitePath}.md`) : undefined

---

<BaseLayout title={title} description={description} siteShell markdownUrl={markdownUrl}>
  <Nav active={active} />
  {active === 'harness' && (
    <div class="site-harness-subnav">
      <HarnessNav />
    </div>
  )}
  <main id="site-main">
    <slot />
  </main>
  <Footer />

  <script>
    import '../scripts/site/motion.ts';
  </script>
</BaseLayout>

<style is:global>
  .site-harness-subnav {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    z-index: 59;
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    border-bottom: 1px solid var(--color-line);
  }
  .site-harness-subnav + #site-main {
    padding-top: calc(72px + 48px);
  }
  [data-site] {
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-sans);
    overflow-x: hidden;
  }
  [data-site] *,
  [data-site] *::before,
  [data-site] *::after {
    box-sizing: border-box;
  }
  [data-site] a {
    text-decoration: none;
  }
  /* Color reset for plain anchors only — buttons own their own colors. */
  [data-site] a:not(.btn):not(.site-btn):not(.site-btn-primary):not(.site-btn-ghost) {
    color: inherit;
  }
  [data-site] main {
    position: relative;
    z-index: 2;
  }
</style>
