---
import StorySection from '../sections/StorySection.astro'
import type { HeadlineSegment } from '../ui/Headline.astro'

type StoryLayout = 'center' | 'viz-left' | 'viz-right'
type StoryTheme = 'default' | 'sunk' | 'gradient'

interface Props {
	id: string
	layout: StoryLayout
	theme?: StoryTheme
	eyebrow?: string
	headline: HeadlineSegment[]
	lede?: string
	items?: string[]
	itemColor?: 'con' | 'found' | 'pilot'
	size?: 'xl' | 'lg' | 'md'
	class?: string
}

const {
	id,
	layout,
	theme = 'default',
	eyebrow,
	headline,
	lede,
	items = [],
	itemColor = 'found',
	size = 'lg',
	class: className = '',
} = Astro.props
---

<StorySection
  id={id}
  layout={layout}
  theme={theme}
  split="balanced"
  eyebrow={eyebrow}
  headline={headline}
  lede={lede}
  items={items}
  itemColor={itemColor}
  size={size}
  class={className}
>
  <div slot="visualization" class="harness-story-visual">
    <slot name="visualization" />
  </div>
</StorySection>
