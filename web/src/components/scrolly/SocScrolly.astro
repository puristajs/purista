<script>
  (function() {
    const stages = document.querySelectorAll('.scrolly-stage');
    const vizStack = document.getElementById('soc-viz-stack');
    const knob = document.querySelector('.scrolly-knob');
    let currentStage = 'problem';

    if (!vizStack || stages.length === 0) return;

    const colors: Record<string, string> = {
      problem: 'con',
      onestep: 'pilot',
      data: 'found',
      scale: 'pilot',
      audit: 'found',
      swap: 'pilot',
    };

    const knobPositions: Record<string, string> = {
      problem: '8%',
      onestep: '23%',
      data: '38%',
      scale: '53%',
      audit: '68%',
      swap: '83%',
    };

    const observer = new IntersectionObserver((entries) => {
      let best: IntersectionObserverEntry | null = null;
      entries.forEach(e => {
        if (e.isIntersecting && (!best || e.intersectionRatio > best.intersectionRatio)) {
          best = e;
        }
      });
      if (best) {
        const id = (best.target as HTMLElement).dataset.stage || 'problem';
        if (id !== currentStage) {
          currentStage = id;
          vizStack.dataset.stage = id;
          stages.forEach(s => {
            const active = (s as HTMLElement).dataset.stage === id;
            (s as HTMLElement).style.opacity = active ? '1' : '0.35';
          });
          if (knob) {
            const color = colors[id] || 'pilot';
            knob.style.top = knobPositions[id] || '8%';
            knob.style.background = `var(--color-${color})`;
            knob.style.borderColor = `var(--color-${color})`;
            knob.style.boxShadow = `0 0 0 6px color-mix(in srgb, var(--color-${color}) 20%, transparent)`;
          }
        }
      }
    }, { threshold: [0.3, 0.5, 0.7], rootMargin: '-30% 0px -30% 0px' });

    stages.forEach(s => observer.observe(s));

    // Initialize first stage as active on load
    const firstStage = stages[0];
    if (firstStage) {
      firstStage.style.opacity = '1';
      const firstId = firstStage.dataset.stage || 'problem';
      currentStage = firstId;
      vizStack.dataset.stage = firstId;
      if (knob) {
        const color = colors[firstId] || 'pilot';
        knob.style.top = knobPositions[firstId] || '8%';
        knob.style.background = `var(--color-${color})`;
        knob.style.borderColor = `var(--color-${color})`;
        knob.style.boxShadow = `0 0 0 6px color-mix(in srgb, var(--color-${color}) 20%, transparent)`;
      }
    }
  })();
</script>

<style>
  .viz-stage { will-change: opacity, transform; }
  #soc-viz-stack[data-stage="problem"] .viz-stage[data-id="problem"],
  #soc-viz-stack[data-stage="onestep"] .viz-stage[data-id="onestep"],
  #soc-viz-stack[data-stage="data"] .viz-stage[data-id="data"],
  #soc-viz-stack[data-stage="scale"] .viz-stage[data-id="scale"],
  #soc-viz-stack[data-stage="audit"] .viz-stage[data-id="audit"],
  #soc-viz-stack[data-stage="swap"] .viz-stage[data-id="swap"] {
    opacity: 1;
    transform: scale(1);
  }
  #soc-viz-stack[data-stage="problem"] .viz-stage:not([data-id="problem"]),
  #soc-viz-stack[data-stage="onestep"] .viz-stage:not([data-id="onestep"]),
  #soc-viz-stack[data-stage="data"] .viz-stage:not([data-id="data"]),
  #soc-viz-stack[data-stage="scale"] .viz-stage:not([data-id="scale"]),
  #soc-viz-stack[data-stage="audit"] .viz-stage:not([data-id="audit"]),
  #soc-viz-stack[data-stage="swap"] .viz-stage:not([data-id="swap"]) {
    opacity: 0;
    transform: scale(0.94);
  }
</style>
