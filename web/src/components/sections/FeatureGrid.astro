---
import type { HeadlineSegment } from '../ui/Headline.astro'
import Headline from '../ui/Headline.astro'

interface Feature {
	title: string
	description: string
}

interface Props {
	eyebrow?: string
	headline?: HeadlineSegment[]
	lede?: string
	features: Feature[]
	columns?: 2 | 3
}

const { eyebrow, headline, lede, features, columns = 3 } = Astro.props

const gridCols = columns === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'
---

<div class="wrap">
  {
    (headline || eyebrow || lede) && (
      <div class="max-w-4xl mb-14 reveal">
        {eyebrow && <div class="eyebrow mb-4">{eyebrow}</div>}
        {headline && (
          <h2 class="display display-xl mb-6">
            <Headline segments={headline} />
          </h2>
        )}
        {lede && <p class="lede">{lede}</p>}
      </div>
    )
  }

  <div class={`grid grid-cols-1 ${gridCols} gap-6 reveal-group`}>
    {
      features.map((feature) => (
        <div class="card reveal">
          <h3 class="font-display font-semibold text-lg mb-2.5">{feature.title}</h3>
          <p class="text-[var(--color-fg-muted)] text-[0.94rem] leading-relaxed">{feature.description}</p>
        </div>
      ))
    }
  </div>
</div>
