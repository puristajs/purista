---
import SectionIntro from '../ui/SectionIntro.astro'

const stages = [
	{
		id: 1,
		tag: 'Definition',
		num: '01 / 02',
		color: 'pilot',
		title: 'Definitions declare',
		highlight: 'the system',
		lede: 'Every block begins with a complete declaration of intent. The contract is reviewable before a single handler is written.',
		bullets: [
			'Strict input & output schemas',
			'Declared dependencies',
			'Policies',
			'Guard & transformer hooks',
			'Resources',
			'Exposure rules',
			'Specs and docs auto-generated',
		],
	},
	{
		id: 2,
		tag: 'Implementation',
		num: '02 / 02',
		color: 'con',
		title: 'Handlers',
		highlight: 'stay small',
		lede: 'When the contract is fixed, the implementation gets small. A pure function. Validated input. Typed output. AI-generated code that fits in a screenshot.',
		bullets: [
			'Pure business logic',
			'First-class test helpers',
			'Predictable file homes',
			'Easy to review',
			'Fast to audit',
		],
	},
]
---

<section class="section-pad-sm" id="harness">
  <div class="wrap">
    <SectionIntro
      class="mb-[clamp(3rem,6vw,5rem)]"
      headline={[
        { text: 'Approval starts ' },
        { text: 'before code', color: 'found' },
        { text: '.' },
      ]}
      lede="PURISTA separates definition, implementation, and runtime wiring so every system has reviewable structure."
    />

    <div class="scrolly-grid relative items-start">
      <div class="scrolly-text relative" id="scrolly-text">
        <div class="absolute left-[-2.25rem] top-0 bottom-0 w-[2px] bg-[var(--color-line)] rounded hidden xl:block" aria-hidden="true">
          <div class="scrolly-knob absolute left-1/2 w-[10px] h-[10px] rounded-full -translate-x-1/2 bg-[var(--color-bg-elev)] border-2 border-[var(--color-line-strong)] transition-all duration-300" style="top: 25%"></div>
        </div>
        {
          stages.map((stage) => (
            <article
              class="scrolly-stage min-h-[88vh] grid content-center py-8 opacity-35 transition-opacity duration-600"
              data-stage={stage.id}
              id={`stage-${stage.id}`}
            >
              <div class="inline-flex items-center gap-[0.65rem] font-mono text-[0.74rem] tracking-[0.14em] uppercase font-semibold mb-5" style={`color: var(--color-${stage.color})`}>
                <span class="px-[0.55rem] py-1 rounded-[5px] font-semibold" style={`background: color-mix(in srgb, var(--color-${stage.color}) 14%, transparent); border: 1px solid color-mix(in srgb, var(--color-${stage.color}) 35%, transparent)`}>
                  {stage.num}
                </span>
                {stage.tag}
              </div>
              <h3 class="h3 mb-4">
                {stage.title} <em class="not-italic" style={`color: var(--color-${stage.color})`}>{stage.highlight}</em>.
              </h3>
              <p class="text-[var(--color-fg-muted)] text-[1.05rem] leading-relaxed mb-6 max-w-[48ch]">{stage.lede}</p>
              <ul class="bullet-list--muted" style={`--bullet-c: var(--color-${stage.color})`}>
                {stage.bullets.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="hidden lg:grid sticky top-[100px] h-[calc(100vh-130px)] items-center">
        <div class="relative w-full aspect-square max-w-[620px] mx-auto" id="viz-stack" data-stage="1">
          {/* Stage 1: Building blocks */}
          <div class="viz-stage absolute inset-0 transition-all duration-700" data-id="1">
            <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="vg" width="30" height="30" patternUnits="userSpaceOnUse">
                  <path d="M 30 0 L 0 0 0 30" fill="none" stroke="var(--color-line)" stroke-width="0.5"/>
                </pattern>
                <radialGradient id="hg-pilot" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="var(--color-pilot-glow)"/>
                  <stop offset="100%" stop-color="transparent"/>
                </radialGradient>
              </defs>
              <rect width="600" height="600" fill="url(#vg)" opacity="0.6"/>
              <circle cx="300" cy="300" r="260" fill="url(#hg-pilot)"/>
              {['SCHEMAS', 'POLICIES', 'HOOKS', 'DEPENDENCIES', 'EXPOSURE', 'GENERATED'].map((label, i) => (
                <g transform={`translate(130 ${40 + i * 68})`}>
                  <rect x="0" y="0" width="340" height="58" rx="8" fill={`color-mix(in srgb, var(--color-${i === 5 ? 'con' : 'pilot'}) ${i === 5 ? '12' : '8'}%, var(--color-bg-elev))`} stroke={`var(--color-${i === 5 ? 'con' : 'pilot'})`}/>
                  <text x="170" y="34" text-anchor="middle" class="svg-label-lg" fill={`var(--color-${i === 5 ? 'con' : 'pilot'})`}>{label}</text>
                </g>
              ))}
              <g stroke="var(--color-line-strong)" stroke-width="0.8" stroke-dasharray="3 3" fill="none" opacity="0.5">
                {[98,166,234,302,370,438].map((y, i) => i < 5 && <line x1="300" y1={y} x2="300" y2={y + 10}/>)}
              </g>
              <text x="300" y="535" text-anchor="middle" class="svg-caption" fill="var(--color-fg-subtle)">— THE CONTRACT ASSEMBLES THE SYSTEM —</text>
            </svg>
          </div>

          {/* Stage 2: Code window */}
          <div class="viz-stage absolute inset-0 opacity-0 scale-[0.94] transition-all duration-700" data-id="2">
            <svg viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="hg-con" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="var(--color-con-glow)"/><stop offset="100%" stop-color="transparent"/></radialGradient>
              </defs>
              <rect width="600" height="600" fill="url(#vg)" opacity="0.6"/>
              <circle cx="300" cy="300" r="220" fill="url(#hg-con)"/>
              <rect x="80" y="80" width="440" height="440" rx="14" fill="none" stroke="var(--color-found)" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.5"/>
              <text x="110" y="108" class="svg-caption" fill="var(--color-found)">PURISTA · STRUCTURAL ENVELOPE</text>
              <g transform="translate(130 190)">
                <rect x="0" y="0" width="340" height="220" rx="11" fill="var(--color-code-bg)" stroke="var(--color-con)" stroke-width="1.6"/>
                <rect x="0" y="0" width="340" height="28" rx="11" fill="rgba(0,0,0,0.25)"/>
                <circle cx="14" cy="14" r="4.5" fill="#e87474"/><circle cx="28" cy="14" r="4.5" fill="#e8c574"/><circle cx="42" cy="14" r="4.5" fill="#74e8a0"/>
                <text x="60" y="18" class="svg-code" fill="rgba(232,232,236,0.55)">support/v1/command/triage-ticket.ts</text>
                <text x="328" y="18" text-anchor="end" class="svg-label" fill="var(--color-con)">AI · ZONE</text>
                <text x="16" y="50" fill="rgba(232,232,236,0.42)" font-style="italic" class="svg-code">// AI writes only what is bounded.</text>
                <text x="16" y="74" fill="#C084FC" class="svg-code">async function</text>
                <text x="124" y="74" fill="#5EEAD4" class="svg-code">triageTicket</text>
                <text x="208" y="74" fill="rgba(232,232,236,0.6)" class="svg-code">({ </text>
                <text x="228" y="74" fill="#E8E8EC" class="svg-code">resource, logger</text>
                <text x="348" y="74" fill="rgba(232,232,236,0.6)" class="svg-code"> },</text>
                <text x="32" y="92" fill="#E8E8EC" class="svg-code">payload</text>
                <text x="80" y="92" fill="rgba(232,232,236,0.6)" class="svg-code">) {</text>
                <text x="32" y="116" fill="#C084FC" class="svg-code">const</text>
                <text x="74" y="116" fill="#E8E8EC" class="svg-code">match = </text>
                <text x="134" y="116" fill="#C084FC" class="svg-code">await</text>
                <text x="172" y="116" fill="#E8E8EC" class="svg-code">resource</text>
                <text x="232" y="116" fill="rgba(232,232,236,0.6)" class="svg-code">.</text>
                <text x="240" y="116" fill="#5EEAD4" class="svg-code">classifier</text>
                <text x="32" y="134" fill="rgba(232,232,236,0.6)" class="svg-code">  .</text>
                <text x="52" y="134" fill="#5EEAD4" class="svg-code">infer</text>
                <text x="92" y="134" fill="rgba(232,232,236,0.6)" class="svg-code">(</text>
                <text x="102" y="134" fill="#E8E8EC" class="svg-code">payload.text</text>
                <text x="196" y="134" fill="rgba(232,232,236,0.6)" class="svg-code">)</text>
                <text x="32" y="158" fill="#C084FC" class="svg-code">return</text>
                <text x="84" y="158" fill="rgba(232,232,236,0.6)" class="svg-code">{</text>
                <text x="98" y="158" fill="#E8E8EC" class="svg-code">priority</text>
                <text x="158" y="158" fill="rgba(232,232,236,0.6)" class="svg-code">: </text>
                <text x="172" y="158" fill="#E8E8EC" class="svg-code">match.priority</text>
                <text x="274" y="158" fill="rgba(232,232,236,0.6)" class="svg-code">,</text>
                <text x="32" y="176" fill="#E8E8EC" class="svg-code">  team</text>
                <text x="72" y="176" fill="rgba(232,232,236,0.6)" class="svg-code">: </text>
                <text x="86" y="176" fill="#E8E8EC" class="svg-code">match.team</text>
                <text x="168" y="176" fill="rgba(232,232,236,0.6)" class="svg-code"> }</text>
                <text x="16" y="196" fill="rgba(232,232,236,0.6)" class="svg-code">}</text>
              </g>
              <g transform="translate(300 440)">
                <rect x="-120" y="-14" width="240" height="28" rx="14" fill="var(--color-bg-elev)" stroke="var(--color-con)" stroke-width="1"/>
                <text y="6" text-anchor="middle" class="svg-label" fill="var(--color-con)">SMALL · ISOLATED · REVIEWABLE</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <SectionIntro
      class="mt-[clamp(4rem,8vw,6rem)]"
      headline={[
        { text: 'AI writes the part it ' },
        { text: 'should write', color: 'con' },
        { text: '.' },
      ]}
      lede="AI works inside focused service blocks while PURISTA carries the production burden. Business logic stays isolated. Dependencies stay declared. Platform behavior stays consistent."
    />
  </div>
</section>

<script>
  const stages = document.querySelectorAll('.scrolly-stage');
  const vizStack = document.getElementById('viz-stack');
  const knob = document.querySelector('.scrolly-knob');
  let currentStage = 1;

  if (vizStack && stages.length) {
    const stageObs = new IntersectionObserver((entries) => {
      let best = null;
      entries.forEach(e => {
        if (e.isIntersecting && (!best || e.intersectionRatio > best.intersectionRatio)) best = e;
      });
      if (best) {
        const n = parseInt(best.target.dataset.stage);
        if (n !== currentStage) {
          currentStage = n;
          vizStack.dataset.stage = n;
          stages.forEach(s => s.classList.toggle('active', s === best.target));
          stages.forEach(s => s.style.opacity = s === best.target ? '1' : '0.35');
          if (knob) {
            knob.style.top = n === 1 ? '25%' : '75%';
            knob.style.background = `var(--color-${n === 1 ? 'pilot' : 'con'})`;
            knob.style.borderColor = `var(--color-${n === 1 ? 'pilot' : 'con'})`;
            knob.style.boxShadow = `0 0 0 6px color-mix(in srgb, var(--color-${n === 1 ? 'pilot' : 'con'}) 20%, transparent)`;
          }
        }
      }
    }, { threshold: [0.3, 0.5, 0.7], rootMargin: '-25% 0px -25% 0px' });
    stages.forEach(s => stageObs.observe(s));

    // Initialize first stage as active on load
    const firstStage = stages[0];
    if (firstStage) {
      firstStage.classList.add('active');
      firstStage.style.opacity = '1';
      vizStack.dataset.stage = '1';
      currentStage = 1;
      if (knob) {
        knob.style.top = '25%';
        knob.style.background = 'var(--color-pilot)';
        knob.style.borderColor = 'var(--color-pilot)';
        knob.style.boxShadow = '0 0 0 6px color-mix(in srgb, var(--color-pilot) 20%, transparent)';
      }
    }
  }
</script>

<style>
  .viz-stage { will-change: opacity, transform; }
  #viz-stack[data-stage="1"] .viz-stage[data-id="1"],
  #viz-stack[data-stage="2"] .viz-stage[data-id="2"] {
    opacity: 1;
    transform: scale(1);
  }
  #viz-stack[data-stage="1"] .viz-stage[data-id="2"],
  #viz-stack[data-stage="2"] .viz-stage[data-id="1"] {
    opacity: 0;
    transform: scale(0.94);
  }
  .scrolly-stage.active { opacity: 1 !important; }
</style>
