---
interface Props {
	icon?: string
	title: string
	description: string
	tags?: string[]
	href?: string
	color?: 'found' | 'con' | 'pilot'
	number?: string | number
	variant?: 'default' | 'horizontal' | 'compact'
}

const { icon, title, description, tags = [], href, color = 'found', number, variant = 'default' } = Astro.props

const isLink = !!href
const Wrapper = isLink ? 'a' : 'div'

const colorVar = `var(--color-${color})`
---

<Wrapper
  href={href}
  class:list={[
    'card group',
    variant === 'horizontal' && 'flex items-start gap-4',
    isLink && 'block no-underline',
  ]}
>
  {variant === 'default' && (
    <>
      <div class="flex items-start gap-4">
        {number !== undefined && (
          <div
            class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-bg)] border border-[var(--color-line)] flex items-center justify-center font-mono text-sm font-bold"
            style={`color: ${colorVar}`}
          >
            {String(number).padStart(2, '0')}
          </div>
        )}
        {icon && !number && (
          <div class="card-icon flex-shrink-0" style={`--icon-color: ${colorVar}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icon} />
          </div>
        )}
        <div class="flex-1 min-w-0">
          <h3 class:list={['card-title', isLink && `group-hover:text-[${colorVar}] transition-colors`]}>{title}</h3>
          <p class="text-[var(--color-fg-muted)] text-sm">{description}</p>
          {tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--color-bg-sunk)] text-[var(--color-fg-muted)] border border-[var(--color-line)]">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </>
  )}

  {variant === 'compact' && (
    <>
      <div class="card-icon" style={`--icon-color: ${colorVar}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icon} />
      </div>
      <h3 class:list={['card-title', isLink && `group-hover:text-[${colorVar}] transition-colors`]}>{title}</h3>
      <p class="text-[var(--color-fg-muted)] text-sm">{description}</p>
    </>
  )}

  {variant === 'horizontal' && (
    <>
      <div class="card-icon flex-shrink-0" style={`--icon-color: ${colorVar}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icon} />
      </div>
      <div>
        <h3 class:list={['card-title', isLink && `group-hover:text-[${colorVar}] transition-colors`]}>{title}</h3>
        <p class="text-[var(--color-fg-muted)] text-sm">{description}</p>
      </div>
    </>
  )}
</Wrapper>
