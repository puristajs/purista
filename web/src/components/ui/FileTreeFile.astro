---
interface Props {
	name: string
	comment?: string
	highlight?: boolean
}
const { name, comment, highlight } = Astro.props
---

<li class="file-tree-item" role="treeitem">
  <div class="file-tree-row">
    <svg class="file-tree-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
    </svg>
    <span class:list={['file-tree-name', { 'file-tree-highlight': highlight }]}>{name}</span>
    {comment && <span class="file-tree-comment">{comment}</span>}
  </div>
</li>
