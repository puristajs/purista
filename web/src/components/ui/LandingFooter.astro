---
interface FooterLink {
	label: string
	href: string
}

interface FooterColumn {
	title: string
	links: FooterLink[]
}

interface Props {
	columns?: FooterColumn[]
	tagline?: string
}

const {
	tagline = 'The open-source TypeScript framework for production-grade enterprise systems.',
	columns = [
		{
			title: 'Framework',
			links: [
				{ label: 'Handbook', href: '/handbook' },
				{ label: 'API reference', href: '#' },
				{ label: 'CLI', href: '#' },
				{ label: 'Examples', href: '#' },
				{ label: 'Migration guide', href: '#' },
			],
		},
		{
			title: 'Learn',
			links: [
				{ label: 'Concept', href: '/' },
				{ label: 'Framework', href: '/framework' },
				{ label: 'AI Harness', href: '/harness' },
				{ label: 'Blog', href: '#' },
			],
		},
		{
			title: 'Community',
			links: [
				{ label: 'GitHub', href: 'https://github.com/puristajs/purista' },
				{ label: 'Discord', href: '#' },
				{ label: 'Twitter / X', href: '#' },
				{ label: 'Sponsors', href: '#' },
			],
		},
	],
} = Astro.props
---

<footer class="py-16 pb-10 border-t border-[var(--color-line)] bg-[var(--color-bg-elev)]">
  <div class="wrap">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(3,1fr)] gap-10 mb-12">
      <div>
        <div class="flex items-center gap-[0.7rem] mb-2">
          <div
            class="w-7 h-7 grid place-items-center bg-[var(--color-fg)] text-[var(--color-bg)] rounded-md font-display font-extrabold text-base tracking-tight"
          >
            P
          </div>
          <div class="font-display font-bold text-[1.05rem] tracking-tight">PURISTA</div>
        </div>
        <p class="text-[var(--color-fg-muted)] max-w-[32ch] text-[0.92rem] mt-[0.85rem]">
          {tagline}
        </p>
      </div>
      {
        columns.map((col) => (
          <div>
            <h5 class="font-mono text-[0.72rem] tracking-[0.14em] uppercase text-[var(--color-fg-subtle)] mb-4 font-semibold">
              {col.title}
            </h5>
            <ul class="space-y-[0.55rem]">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[var(--color-fg-muted)] text-[0.92rem] transition-colors duration-180 hover:text-[var(--color-fg)] inline-block hover:translate-x-0.5"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="flex justify-between flex-wrap gap-4 pt-8 border-t border-[var(--color-line)] text-[0.85rem] text-[var(--color-fg-subtle)] font-mono tracking-wide"
    >
      <div>© 2026 — Made by developers for developers, with care.</div>
      <div>Privacy · Imprint · Cookies</div>
    </div>
  </div>
</footer>
