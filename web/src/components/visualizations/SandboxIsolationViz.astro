---
interface Props {
	class?: string
}
const { class: className = '' } = Astro.props
---

<svg viewBox="0 0 520 300" xmlns="http://www.w3.org/2000/svg" class:list={['w-full', className]}>
  <defs>
    <marker id="sbArrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <path d="M 0 0.5 L 8 3 L 0 5.5 Z" fill="var(--color-con)" opacity="0.5"/>
    </marker>
  </defs>
  <rect x="30" y="20" width="460" height="260" rx="12" fill="var(--color-bg-elev)" stroke="var(--color-line)" stroke-width="1"/>
  <text x="260" y="46" text-anchor="middle" class="svg-caption" fill="var(--color-fg-subtle)">SANDBOX ISOLATION LEVELS</text>
  <rect x="60" y="70" width="130" height="70" rx="8" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 20%, transparent)" stroke-width="0.8"/>
  <text x="125" y="96" text-anchor="middle" class="svg-label" fill="var(--color-found)">IN-MEMORY</text>
  <text x="125" y="114" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">Files only</text>
  <text x="125" y="128" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">No commands</text>
  <rect x="210" y="70" width="130" height="70" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 20%, transparent)" stroke-width="0.8"/>
  <text x="275" y="96" text-anchor="middle" class="svg-label" fill="var(--color-con)">BASH</text>
  <text x="275" y="114" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">File + commands</text>
  <text x="275" y="128" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">just-bash executor</text>
  <rect x="360" y="70" width="110" height="70" rx="8" fill="color-mix(in srgb, var(--color-pilot) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-pilot) 20%, transparent)" stroke-width="0.8"/>
  <text x="415" y="96" text-anchor="middle" class="svg-label" fill="var(--color-pilot)">CUSTOM</text>
  <text x="415" y="114" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">Containers</text>
  <text x="415" y="128" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">Remote exec</text>
  <rect x="160" y="170" width="200" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="260" y="192" text-anchor="middle" class="svg-label" fill="var(--color-con)">AGENT</text>
  <text x="260" y="210" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">Runs inside chosen sandbox</text>
  <rect x="60" y="240" width="130" height="36" rx="6" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 18%, transparent)" stroke-width="0.8"/>
  <text x="125" y="262" text-anchor="middle" class="svg-body-xs" fill="var(--color-found)">MCP stdio</text>
  <rect x="210" y="240" width="130" height="36" rx="6" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 18%, transparent)" stroke-width="0.8"/>
  <text x="275" y="262" text-anchor="middle" class="svg-body-xs" fill="var(--color-found)">TS Tools</text>
  <rect x="360" y="240" width="110" height="36" rx="6" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 18%, transparent)" stroke-width="0.8"/>
  <text x="415" y="262" text-anchor="middle" class="svg-body-xs" fill="var(--color-found)">Built-in</text>
  <g stroke="var(--color-con)" stroke-width="1" fill="none" opacity="0.4" marker-end="url(#sbArrow)">
    <line x1="125" y1="140" x2="210" y2="170"/>
    <line x1="275" y1="140" x2="260" y2="170"/>
    <line x1="415" y1="140" x2="310" y2="170"/>
    <line x1="260" y1="220" x2="125" y2="240"/>
    <line x1="260" y1="220" x2="275" y2="240"/>
    <line x1="260" y1="220" x2="415" y2="240"/>
  </g>
  <text x="160" y="160" class="svg-body-xs" fill="var(--color-fg-muted)">All respect same boundary</text>
</svg>
