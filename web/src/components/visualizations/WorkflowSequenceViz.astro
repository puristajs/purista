---
interface Props {
	class?: string
}
const { class: className = '' } = Astro.props
---

<svg viewBox="0 0 700 140" xmlns="http://www.w3.org/2000/svg" class:list={['w-full', className]}>
  <defs>
    <marker id="wfArrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <path d="M 0 0.5 L 8 3 L 0 5.5 Z" fill="var(--color-found)" opacity="0.5"/>
    </marker>
  </defs>
  <rect x="10" y="20" width="120" height="50" rx="8" fill="color-mix(in srgb, var(--color-pilot) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-pilot) 18%, transparent)" stroke-width="0.8"/>
  <text x="70" y="42" text-anchor="middle" class="svg-label" fill="var(--color-pilot)">INPUT</text>
  <text x="70" y="58" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">topic: string</text>
  <rect x="160" y="20" width="120" height="50" rx="8" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 18%, transparent)" stroke-width="0.8"/>
  <text x="220" y="42" text-anchor="middle" class="svg-label" fill="var(--color-found)">RESEARCHER</text>
  <text x="220" y="58" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">finds facts</text>
  <rect x="310" y="20" width="120" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="370" y="42" text-anchor="middle" class="svg-label" fill="var(--color-con)">WRITER</text>
  <text x="370" y="58" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">produces draft</text>
  <rect x="460" y="20" width="120" height="50" rx="8" fill="color-mix(in srgb, var(--color-pilot) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-pilot) 18%, transparent)" stroke-width="0.8"/>
  <text x="520" y="42" text-anchor="middle" class="svg-label" fill="var(--color-pilot)">CRITIC</text>
  <text x="520" y="58" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">checks accuracy</text>
  <rect x="610" y="20" width="80" height="50" rx="8" fill="color-mix(in srgb, var(--color-found) 8%, var(--color-bg-elev))" stroke="var(--color-found)" stroke-width="1"/>
  <text x="650" y="47" text-anchor="middle" class="svg-label" fill="var(--color-found)">OUTPUT</text>
  <g stroke="var(--color-found)" stroke-width="1" fill="none" opacity="0.4" marker-end="url(#wfArrow)">
    <line x1="130" y1="45" x2="160" y2="45"/>
    <line x1="280" y1="45" x2="310" y2="45"/>
    <line x1="430" y1="45" x2="460" y2="45"/>
    <line x1="580" y1="45" x2="610" y2="45"/>
  </g>
  <text x="350" y="100" text-anchor="middle" class="svg-caption" fill="var(--color-fg-subtle)">WORKFLOW ORCHESTRATES AGENTS IN SEQUENCE</text>
</svg>
