---
interface Props {
	variant: 'bad' | 'good'
}

const { variant } = Astro.props
const isBad = variant === 'bad'
---

<svg class="funnel-svg" viewBox="0 0 400 560" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={isBad ? 'fbad' : 'fgood'} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={isBad ? 'color-mix(in srgb, var(--color-con) 5%, var(--color-bg-elev))' : 'color-mix(in srgb, var(--color-found) 4%, var(--color-bg-elev))'} />
      <stop offset="100%" stop-color={isBad ? 'color-mix(in srgb, var(--color-pilot) 8%, var(--color-bg-elev))' : 'color-mix(in srgb, var(--color-found) 8%, var(--color-bg-elev))'} />
    </linearGradient>
  </defs>
  <path d="M 40 10 L 360 10 L 280 460 L 120 460 Z" fill={`url(#${isBad ? 'fbad' : 'fgood'})`} opacity="0.2" stroke="var(--color-line)" stroke-width="1"/>
  <line x1="40" y1="10" x2="120" y2="460" stroke={isBad ? 'color-mix(in srgb, var(--color-pilot) 20%, transparent)' : 'color-mix(in srgb, var(--color-found) 20%, transparent)'} stroke-width="1" stroke-dasharray="4 3"/>
