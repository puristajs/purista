---
interface Props {
	class?: string
}
const { class: className = '' } = Astro.props
---

<svg viewBox="0 0 520 320" xmlns="http://www.w3.org/2000/svg" class:list={['w-full', className]}>
  <defs>
    <marker id="adArrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <path d="M 0 0.5 L 8 3 L 0 5.5 Z" fill="var(--color-found)" opacity="0.5"/>
    </marker>
  </defs>
  <rect x="30" y="20" width="460" height="280" rx="12" fill="var(--color-bg-elev)" stroke="var(--color-line)" stroke-width="1"/>
  <text x="260" y="46" text-anchor="middle" class="svg-caption" fill="var(--color-fg-subtle)">ADAPTER ARCHITECTURE</text>
  <rect x="50" y="70" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-pilot) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-pilot) 18%, transparent)" stroke-width="0.8"/>
  <text x="120" y="92" text-anchor="middle" class="svg-label" fill="var(--color-pilot)">YOUR CODE</text>
  <text x="120" y="110" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">session.agents.answerer()</text>
  <rect x="50" y="150" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="120" y="172" text-anchor="middle" class="svg-label" fill="var(--color-con)">BASE PROVIDER</text>
  <text x="120" y="190" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">timeout · cancel · trace</text>
  <rect x="50" y="230" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-found) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-found) 18%, transparent)" stroke-width="0.8"/>
  <text x="120" y="252" text-anchor="middle" class="svg-label" fill="var(--color-found)">ADAPTER</text>
  <text x="120" y="270" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">translate · normalize</text>
  <rect x="330" y="70" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="400" y="92" text-anchor="middle" class="svg-label" fill="var(--color-con)">OPENAI SDK</text>
  <text x="400" y="110" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">chat.completions.create</text>
  <rect x="330" y="150" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="400" y="172" text-anchor="middle" class="svg-label" fill="var(--color-con)">ANTHROPIC SDK</text>
  <text x="400" y="190" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">messages.create</text>
  <rect x="330" y="230" width="140" height="50" rx="8" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="400" y="252" text-anchor="middle" class="svg-label" fill="var(--color-con)">BEDROCK SDK</text>
  <text x="400" y="270" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">invokeModel</text>
  <g stroke="var(--color-found)" stroke-width="1" fill="none" opacity="0.4" marker-end="url(#adArrow)">
    <line x1="190" y1="95" x2="330" y2="95"/>
    <line x1="190" y1="175" x2="330" y2="175"/>
    <line x1="190" y1="255" x2="330" y2="255"/>
  </g>
  <text x="260" y="88" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">normalized request</text>
  <text x="260" y="168" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">normalized request</text>
  <text x="260" y="248" text-anchor="middle" class="svg-body-xs" fill="var(--color-fg-muted)">normalized request</text>
</svg>
