---
interface Props {
	class?: string
}
const { class: className = '' } = Astro.props
---

<svg viewBox="0 0 520 280" xmlns="http://www.w3.org/2000/svg" class:list={['w-full', className]}>
  <defs>
    <marker id="rgArrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
      <path d="M 0 0.5 L 8 3 L 0 5.5 Z" fill="var(--color-found)" opacity="0.5"/>
    </marker>
  </defs>
  <rect x="30" y="20" width="460" height="240" rx="12" fill="var(--color-bg-elev)" stroke="var(--color-line)" stroke-width="1"/>
  <text x="260" y="46" text-anchor="middle" class="svg-caption" fill="var(--color-fg-subtle)">REVIEW GATE FLOW</text>
  <rect x="50" y="70" width="100" height="40" rx="6" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="100" y="95" text-anchor="middle" class="svg-body-sm" fill="var(--color-con)">Proposal</text>
  <rect x="190" y="70" width="140" height="40" rx="6" fill="color-mix(in srgb, var(--color-found) 8%, var(--color-bg-elev))" stroke="var(--color-found)" stroke-width="1"/>
  <text x="260" y="95" text-anchor="middle" class="svg-label" fill="var(--color-found)">REVIEW REQUEST</text>
  <rect x="190" y="140" width="140" height="40" rx="6" fill="color-mix(in srgb, var(--color-pilot) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-pilot) 18%, transparent)" stroke-width="0.8"/>
  <text x="260" y="165" text-anchor="middle" class="svg-body-sm" fill="var(--color-pilot)">Questionnaire UI</text>
  <rect x="370" y="140" width="100" height="40" rx="6" fill="color-mix(in srgb, var(--color-con) 6%, var(--color-bg-elev))" stroke="color-mix(in srgb, var(--color-con) 18%, transparent)" stroke-width="0.8"/>
  <text x="420" y="165" text-anchor="middle" class="svg-body-sm" fill="var(--color-con)">Decision</text>
  <rect x="190" y="210" width="140" height="36" rx="6" fill="color-mix(in srgb, var(--color-found) 8%, var(--color-bg-elev))" stroke="var(--color-found)" stroke-width="1"/>
  <text x="260" y="233" text-anchor="middle" class="svg-body-xs" fill="var(--color-found)">Write tool (if approved)</text>
  <g stroke="var(--color-found)" stroke-width="1" fill="none" opacity="0.4" marker-end="url(#rgArrow)">
    <line x1="150" y1="90" x2="190" y2="90"/>
    <line x1="260" y1="110" x2="260" y2="140"/>
    <line x1="330" y1="160" x2="370" y2="160"/>
    <line x1="420" y1="180" x2="420" y2="200"/>
    <line x1="390" y1="210" x2="340" y2="228"/>
  </g>
  <text x="170" y="82" class="svg-body-xs" fill="var(--color-fg-muted)">drafts</text>
  <text x="275" y="128" class="svg-body-xs" fill="var(--color-fg-muted)">presents</text>
  <text x="350" y="152" class="svg-body-xs" fill="var(--color-fg-muted)">answers</text>
</svg>
