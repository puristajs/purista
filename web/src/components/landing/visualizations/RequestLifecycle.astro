---
/**
 * One request, end to end — animated horizontal sequence.
 *
 * A single token travels left → right through 8 enterprise checkpoints.
 * Each stop lights up its column with a tonal pulse and reveals the
 * enterprise concern it solves (audit, IAM, compliance, etc.).
 *
 * The animation loops; on first scroll the columns fade in left → right
 * before the token starts moving.
 */

interface Stage {
	k: string
	num: string
	title: string
	enterprise: string
	tone: 'found' | 'con' | 'pilot'
	icon: string
}

const stages: Stage[] = [
	{
		k: 'in',
		num: '01',
		title: 'Request arrives',
		enterprise: 'HTTP / event / queue — same gateway.',
		tone: 'found',
		icon: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
	},
	{
		k: 'val',
		num: '02',
		title: 'Schema validated',
		enterprise: 'Zod gate. Bad input never reaches code.',
		tone: 'found',
		icon: '<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/>',
	},
	{
		k: 'guard',
		num: '03',
		title: 'Guards enforced',
		enterprise: 'Before guards run auth, quota, and policy checks in parallel.',
		tone: 'con',
		icon: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
	},
	{
		k: 'trace',
		num: '04',
		title: 'Trace span opened',
		enterprise: 'Distributed trace starts. OTel context propagated automatically.',
		tone: 'con',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	},
	{
		k: 'do',
		num: '05',
		title: 'Handler runs',
		enterprise: 'Your business logic — the only code you write.',
		tone: 'pilot',
		icon: '<polyline points="8 6 2 12 8 18"/><polyline points="16 6 22 12 16 18"/>',
	},
	{
		k: 'validate',
		num: '06',
		title: 'Output validated',
		enterprise: 'Output schema checked. Bad data never reaches the caller.',
		tone: 'pilot',
		icon: '<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/>',
	},
	{
		k: 'emit',
		num: '07',
		title: 'Event emitted',
		enterprise: 'Downstream services react via subscriptions.',
		tone: 'found',
		icon: '<circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="10"/>',
	},
	{
		k: 'out',
		num: '08',
		title: 'Response returned',
		enterprise: 'Typed output. Trace closed. Span correlated.',
		tone: 'pilot',
		icon: '<path d="M19 12H5"/><path d="M11 6l-6 6 6 6"/>',
	},
]
---

<div class="vrl" role="img" aria-label="One request travels through eight checkpoints — validate, guards, trace, handler, output validate, emit, response.">
  {/* Rail */}
  <div class="vrl-rail" aria-hidden="true">
    <span class="vrl-rail-base"></span>
    <span class="vrl-rail-flow"></span>
    <span class="vrl-token"></span>
  </div>

  <div class="vrl-row">
    {stages.map((s, i) => (
      <article
        class="vrl-cell"
        data-tone={s.tone}
        style={`--tone: var(--color-${s.tone}); --tone-hi: var(--color-${s.tone}-hi); --i:${i}`}
      >
        <span class="vrl-node" aria-hidden="true"></span>
        <header class="vrl-head">
          <span class="vrl-num site-mono">{s.num}</span>
          <span class="vrl-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </span>
        </header>
        <h4 class="vrl-title">{s.title}</h4>
        <p class="vrl-body">{s.enterprise}</p>
      </article>
    ))}
  </div>

  <footer class="vrl-foot">
    <span class="vrl-foot-dot vrl-foot-dot--found" aria-hidden="true"></span>
    <span class="site-mono">Gateway</span>
    <span class="vrl-foot-sep">·</span>
    <span class="vrl-foot-dot vrl-foot-dot--con" aria-hidden="true"></span>
    <span class="site-mono">Policy</span>
    <span class="vrl-foot-sep">·</span>
    <span class="vrl-foot-dot vrl-foot-dot--pilot" aria-hidden="true"></span>
    <span class="site-mono">Execution</span>
    <span class="vrl-foot-sep">·</span>
    <span class="site-mono" style="color:var(--color-fg-subtle)">end-to-end ~1.6s</span>
  </footer>
</div>

<style>
  .vrl {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    padding: 1.2rem 0 0;
  }

  /* ─────────── Rail ─────────── */
  .vrl-rail {
    position: relative;
    height: 26px;
    margin: 0 18px 0.5rem;
  }
  .vrl-rail-base {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    transform: translateY(-50%);
    background: var(--color-line);
    border-radius: 999px;
  }
  .vrl-rail-flow {
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    transform: translateY(-50%);
    background: linear-gradient(to right,
      var(--color-found-hi),
      var(--color-con-hi) 35%,
      var(--color-pilot-hi) 70%,
      var(--color-found-hi));
    background-size: 200% 100%;
    border-radius: 999px;
    animation: vrl-rail-flow 6s linear infinite;
  }
  @keyframes vrl-rail-flow {
    from { background-position: 0% 0; }
    to   { background-position: 200% 0; }
  }
  .vrl-token {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%,
      var(--color-fg-strong),
      var(--color-found-hi) 60%,
      var(--color-found) 100%);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--color-found) 22%, transparent),
      0 0 22px var(--color-found-glow);
    transform: translate(-50%, -50%);
    animation: vrl-token 6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes vrl-token {
    0%   { left: 0%;   background: radial-gradient(circle at 30% 30%, var(--color-fg-strong), var(--color-found-hi) 60%, var(--color-found) 100%); }
    35%  { background: radial-gradient(circle at 30% 30%, var(--color-fg-strong), var(--color-con-hi) 60%, var(--color-con) 100%); }
    70%  { background: radial-gradient(circle at 30% 30%, var(--color-fg-strong), var(--color-pilot-hi) 60%, var(--color-pilot) 100%); }
    100% { left: 100%; background: radial-gradient(circle at 30% 30%, var(--color-fg-strong), var(--color-found-hi) 60%, var(--color-found) 100%); }
  }

  /* ─────────── Row of cells ─────────── */
  .vrl-row {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.55rem;
    position: relative;
  }
  @media (max-width: 1100px) {
    .vrl-row { grid-template-columns: repeat(4, 1fr); }
    .vrl-rail { display: none; }
  }
  @media (max-width: 640px) {
    .vrl-row { grid-template-columns: repeat(2, 1fr); }
  }

  .vrl-cell {
    position: relative;
    padding: 0.85rem 0.85rem 0.95rem;
    border-radius: 12px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--tone) 8%, var(--color-bg-elev)),
      color-mix(in srgb, var(--color-bg-sunk) 95%, transparent));
    opacity: 0;
    transform: translateY(8px);
    animation: vrl-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 0.08s + 0.1s);
    min-height: 156px;
  }
  @keyframes vrl-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Connector dot at top centered over the cell — visually anchors to the rail */
  .vrl-node {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--tone-hi);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--tone) 24%, transparent);
  }
  @media (max-width: 1100px) {
    .vrl-node { display: none; }
  }

  .vrl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
  }
  .vrl-num {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--tone-hi);
  }
  .vrl-icon {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: color-mix(in srgb, var(--tone) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone) 32%, transparent);
    color: var(--tone-hi);
  }
  .vrl-icon svg { width: 14px; height: 14px; }

  .vrl-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.96rem;
    letter-spacing: 0;
    color: var(--color-fg-strong);
    line-height: 1.15;
  }
  .vrl-body {
    margin-top: 0.4rem;
    color: var(--color-fg-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  /* Pulse highlight that travels in sync with the token */
  .vrl-cell {
    --pulse-active: 0;
  }
  .vrl-cell {
    animation:
      vrl-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      vrl-pulse 6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    animation-delay: calc(var(--i) * 0.08s + 0.1s), calc(var(--i) * 0.75s);
  }
  @keyframes vrl-pulse {
    0%, 14%, 100% { box-shadow: none; border-color: var(--color-line-strong); }
    7%            { box-shadow: 0 0 22px -2px color-mix(in srgb, var(--tone) 60%, transparent); border-color: color-mix(in srgb, var(--tone) 70%, transparent); }
  }

  /* ─────────── Footer key ─────────── */
  .vrl-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-line);
    color: var(--color-fg-muted);
    font-size: 0.78rem;
    flex-wrap: wrap;
  }
  .vrl-foot-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .vrl-foot-dot--found { background: var(--color-found); }
  .vrl-foot-dot--con   { background: var(--color-con); }
  .vrl-foot-dot--pilot { background: var(--color-pilot); }
  .vrl-foot-sep        { color: var(--color-line-vivid); }

  @media (prefers-reduced-motion: reduce) {
    .vrl-rail-flow, .vrl-token, .vrl-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
