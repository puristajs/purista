---
/**
 * Runtime matrix — one service definition, four runtimes.
 *
 * Renders four target runtimes (laptop, CI, Kubernetes, serverless/edge)
 * fed by a single "service.ts" source. Each target shows which adapter combo
 * is bound at runtime. CSS-driven flow particles animate the wiring.
 */

interface Target {
	key: string
	label: string
	tag: string
	tone: 'found' | 'con' | 'pilot'
	stack: string[]
	ribbon: string
}

const targets: Target[] = [
	{
		key: 'local',
		label: 'Local',
		tag: 'developer laptop',
		tone: 'found',
		stack: ['in-memory bridge', 'env secrets', 'in-memory store', 'no broker'],
		ribbon: 'fastest loop',
	},
	{
		key: 'ci',
		label: 'CI',
		tag: 'ephemeral pipeline',
		tone: 'con',
		stack: ['DefaultEventBridge', 'env secrets', 'DefaultStateStore', 'mock adapters'],
		ribbon: 'reproducible',
	},
	{
		key: 'cluster',
		label: 'Kubernetes',
		tag: 'production cluster',
		tone: 'pilot',
		stack: ['NatsBridge', 'vault-secret-store', 'redis-state-store', 'OTel collector'],
		ribbon: 'high-throughput',
	},
	{
		key: 'edge',
		label: 'Serverless · Edge',
		tag: 'global, pay-per-call',
		tone: 'found',
		stack: ['DefaultEventBridge', 'aws-secret-store', 'aws-config-store', 'OTLP → CloudWatch'],
		ribbon: 'low overhead',
	},
]
---

<div class="vrm">
  {/* ─── Source: the one service definition ─── */}
  <div class="vrm-source">
    <div class="vrm-source-card">
      <header class="vrm-source-header">
        <span class="vrm-source-dots"><span></span><span></span><span></span></span>
        <span class="vrm-source-filename">order.service.ts</span>
        <span class="vrm-source-tag">YOUR CODE</span>
      </header>
      <div class="vrm-source-body">
        <span class="vrm-line"><span class="vrm-kw">import</span> {`{`} ServiceBuilder {`}`} <span class="vrm-kw">from</span> <span class="vrm-str">'@purista/core'</span></span>
        <span class="vrm-line">&nbsp;</span>
        <span class="vrm-line"><span class="vrm-kw">export const</span> orderService = <span class="vrm-kw">new</span> <span class="vrm-fn">ServiceBuilder</span>({`{`}</span>
        <span class="vrm-line">  serviceName: <span class="vrm-str">'Order'</span>,</span>
        <span class="vrm-line">  serviceVersion: <span class="vrm-str">'1'</span>,</span>
        <span class="vrm-line">{`}`} <span class="vrm-kw">as const</span>)</span>
        <span class="vrm-line">  .<span class="vrm-fn">addCommandDefinition</span>(createOrder, cancel)</span>
        <span class="vrm-line">  .<span class="vrm-fn">addSubscriptionDefinition</span>(onPaid)</span>
      </div>
      <footer class="vrm-source-footer">
        <span>typed contracts</span><i></i>
        <span>OTel built in</span><i></i>
        <span>Zod-validated</span>
      </footer>
    </div>
  </div>

  {/* ─── Flow lines + targets ─── */}
  <div class="vrm-fan">
    <svg class="vrm-fanlines" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        {(['found', 'con', 'pilot'] as const).map((t) => (
          <linearGradient id={`vrm-grad-${t}`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0%"  stop-color={`var(--color-${t})`} stop-opacity="0" />
            <stop offset="50%" stop-color={`var(--color-${t}-hi)`} stop-opacity="1" />
            <stop offset="100%" stop-color={`var(--color-${t})`} stop-opacity="0" />
          </linearGradient>
        ))}
      </defs>
      {targets.map((t, i) => {
        const x = 125 + i * 250;
        const d = `M 500 6 C 500 110, ${x} 110, ${x} 214`;
        return (
          <g style={`--delay:${i * 0.25}s`}>
            <path d={d} stroke="rgba(255,255,255,0.08)" stroke-width="1.4" fill="none" />
            <path
              d={d}
              stroke={`url(#vrm-grad-${t.tone})`}
              stroke-width="2"
              fill="none"
              class="vrm-flow"
            />
          </g>
        );
      })}
    </svg>

    <div class="vrm-targets">
      {targets.map((t, i) => (
        <article class={`vrm-target vrm-target--${t.tone}`} style={`--i:${i}; --tone: var(--color-${t.tone}); --tone-hi: var(--color-${t.tone}-hi)`}>
          <header class="vrm-target-head">
            <span class="vrm-target-label">{t.label}</span>
            <span class="vrm-target-ribbon">{t.ribbon}</span>
          </header>
          <span class="vrm-target-sub">{t.tag}</span>
          <ul class="vrm-target-stack">
            {t.stack.map((s) => (
              <li><span class="vrm-bullet"></span>{s}</li>
            ))}
          </ul>
          <footer class="vrm-target-foot">
            <span class="vrm-mono">{
              t.key === 'local'   ? '// DefaultEventBridge — no config needed' :
              t.key === 'ci'      ? '// DefaultEventBridge — deterministic' :
              t.key === 'cluster' ? '// new NatsBridge({ url: process.env.NATS_URL })' :
                                    '// DefaultEventBridge + aws-secret-store'
            }</span>
          </footer>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .vrm {
    position: relative;
    width: 100%;
    display: grid;
    gap: 1.4rem;
  }

  /* ============ Source card ============ */
  .vrm-source {
    display: flex;
    justify-content: center;
  }
  .vrm-source-card {
    width: 100%;
    max-width: 720px;
    border-radius: 18px;
    border: 1px solid var(--color-line-strong);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--color-bg-elev) 95%, transparent),
      color-mix(in srgb, var(--color-bg-sunk) 90%, transparent));
    overflow: hidden;
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.6),
                inset 0 1px 0 rgba(255,255,255,0.05);
  }
  .vrm-source-header {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-deep) 60%, transparent);
  }
  .vrm-source-dots { display: inline-flex; gap: 0.4rem; }
  .vrm-source-dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--color-line-vivid); }
  .vrm-source-dots span:nth-child(1) { background: #FF5F57; }
  .vrm-source-dots span:nth-child(2) { background: #FEBC2E; }
  .vrm-source-dots span:nth-child(3) { background: #28C840; }
  .vrm-source-filename {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-fg-muted);
  }
  .vrm-source-tag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--color-found-hi);
    text-transform: uppercase;
  }
  .vrm-source-body {
    padding: 1rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--color-fg);
  }
  .vrm-source-body .vrm-line { display: block; }
  .vrm-kw  { color: var(--color-con-hi); }
  .vrm-fn  { color: var(--color-found-hi); }
  .vrm-str { color: var(--color-pilot-hi); }
  .vrm-cmt { color: var(--color-fg-subtle); }
  .vrm-source-footer {
    display: flex; align-items: center; gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.7rem 1.2rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg-deep) 40%, transparent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.04em;
  }
  .vrm-source-footer i {
    display: inline-block;
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--color-line-vivid);
  }

  /* ============ Fan + targets ============ */
  .vrm-fan {
    position: relative;
    padding-top: 110px;
  }
  .vrm-fanlines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 220px;
    pointer-events: none;
  }
  .vrm-flow {
    stroke-dasharray: 16 220;
    animation: vrm-flow 3.4s linear infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes vrm-flow {
    from { stroke-dashoffset: 236; opacity: 0.25; }
    20%  { opacity: 1; }
    80%  { opacity: 1; }
    to   { stroke-dashoffset: 0; opacity: 0.25; }
  }

  .vrm-targets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 1024px) {
    .vrm-targets { grid-template-columns: repeat(2, 1fr); }
    .vrm-fanlines { display: none; }
    .vrm-fan { padding-top: 1rem; }
  }
  @media (max-width: 560px) {
    .vrm-targets { grid-template-columns: 1fr; }
  }

  .vrm-target {
    border: 1px solid var(--color-line-strong);
    border-radius: 16px;
    padding: 1.1rem 1.1rem 1rem;
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--tone) 8%, var(--color-bg-elev)),
      color-mix(in srgb, var(--color-bg-sunk) 95%, transparent));
    box-shadow: 0 18px 36px -22px rgba(0,0,0,0.6),
                inset 0 1px 0 rgba(255,255,255,0.05);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    opacity: 0;
    transform: translateY(12px);
    animation: vrm-pop 0.7s cubic-bezier(0.16,1,0.3,1) forwards;
    animation-delay: calc(var(--i) * 0.12s + 0.4s);
  }
  @keyframes vrm-pop {
    to { opacity: 1; transform: translateY(0); }
  }
  .vrm-target-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .vrm-target-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-fg-strong);
    letter-spacing: 0;
  }
  .vrm-target-ribbon {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tone-hi);
    background: color-mix(in srgb, var(--tone) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone) 34%, transparent);
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
  }
  .vrm-target-sub {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--color-fg-muted);
  }
  .vrm-target-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .vrm-target-stack li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .vrm-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 8px var(--tone);
  }
  .vrm-target-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-subtle);
    overflow-x: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .vrm-target, .vrm-flow { animation: none; opacity: 1; transform: none; }
  }
</style>
