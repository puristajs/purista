---
import ThemeToggle from '../ui/ThemeToggle.tsx'

interface Props {
	active?: 'home' | 'framework' | 'enterprise' | 'harness' | 'handbook'
}

const { active = 'home' } = Astro.props

const links = [
	{ href: '/', label: 'Explore', key: 'home' },
	{ href: '/enterprise/', label: 'Enterprise', key: 'enterprise' },
	{ href: '/framework/', label: 'Framework', key: 'framework' },
	{ href: '/harness/', label: 'AI Harness', key: 'harness' },
	{ href: '/handbook/', label: 'Handbook', key: 'handbook' },
]
---

<nav class="site-nav" aria-label="Primary">
  <div class="site-nav-inner">
    <a href="/" class="site-brand" aria-label="PURISTA home">
      <span class="site-brand-mark">P</span>
      <span>PURISTA</span>
    </a>

    <div class="site-nav-links">
      {
        links.map((l) => (
          <a
            href={l.href}
            class={`site-nav-link${active === l.key ? ' is-active' : ''}`}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="site-nav-actions">
      <ThemeToggle client:load />
      <details class="site-nav-mobile">
        <summary aria-label="Open navigation menu">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="site-nav-mobile-panel">
          {
            links.map((l) => (
              <a
                href={l.href}
                class={active === l.key ? 'is-active' : undefined}
              >
                {l.label}
              </a>
            ))
          }
          <a href="https://github.com/puristajs/purista" target="_blank" rel="noopener">GitHub</a>
        </div>
      </details>
      <a
        href="https://github.com/puristajs/purista"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="site-btn site-btn-ghost"
        style="padding:.55rem 1rem;font-size:.82rem;"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.17c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.32.47-2.4 1.24-3.24-.13-.31-.54-1.55.12-3.23 0 0 1-.32 3.3 1.23a11.4 11.4 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.68.25 2.92.12 3.23.78.84 1.24 1.92 1.24 3.24 0 4.62-2.81 5.65-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A12 12 0 0 0 12 .3z" />
        </svg>
        <span>Star on GitHub</span>
      </a>
    </div>
  </div>
</nav>
