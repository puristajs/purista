---
import { learningPaths } from '../../data/handbook'
---

<div class="grid gap-2">
  {learningPaths.map((path) => (
    <a
      href={`/handbook/learn/${path.slug}/`}
      class="group flex items-center gap-4 p-4 rounded-xl border border-[var(--color-line)] bg-[var(--color-bg-elev)] transition-all duration-200 hover:border-[var(--color-line-vivid)] hover:shadow-sm"
    >
      <div class="shrink-0">
        <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-found)]" />
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-3 flex-wrap">
          <span class="font-display font-medium text-[0.88rem] text-[var(--color-fg)] group-hover:text-[var(--color-found)] transition-colors">
            {path.title}
          </span>
          <span class="font-mono text-[0.68rem] tracking-wide text-[var(--color-fg-subtle)]">
            {path.duration}
          </span>
        </div>
        <p class="text-[0.8rem] text-[var(--color-fg-muted)] mt-0.5 leading-relaxed">
          {path.description}
        </p>
      </div>
      <span class="shrink-0 text-[var(--color-fg-subtle)] group-hover:text-[var(--color-found)] transition-colors text-sm">
        →
      </span>
    </a>
  ))}
</div>
