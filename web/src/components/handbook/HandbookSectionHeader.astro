---
interface Props {
	title: string
	subtitle: string
}

const { title, subtitle } = Astro.props
---

<div class="mb-8">
  <h2 class="font-display font-semibold text-[1.5rem] tracking-tight mb-2" style="color: var(--color-pilot)">
    {title}
  </h2>
  <p class="lede max-w-[60ch]">{subtitle}</p>
</div>
