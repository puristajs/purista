---
interface Props {
	name: string
	color?: string
}

const { name, color = 'currentColor' } = Astro.props
---

<div class="handbook-icon-wrap" style={`color: ${color}`}>
  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="handbook-icon-svg">

    {name === 'layers' && (
      <g class="icon-inner">
        <rect x="10" y="28" width="28" height="6" rx="2" stroke="currentColor" stroke-width="2" opacity="0.5" class="icon-layer-lag" />
        <rect x="10" y="20" width="28" height="6" rx="2" stroke="currentColor" stroke-width="2" opacity="0.7" class="icon-layer-mid" />
        <rect x="10" y="12" width="28" height="6" rx="2" stroke="currentColor" stroke-width="2" class="icon-layer-top" />
        <circle cx="36" cy="10" r="3" fill="currentColor" class="icon-accent" opacity="0.6" />
      </g>
    )}

    {name === 'certificate' && (
      <g class="icon-inner">
        <rect x="12" y="8" width="24" height="28" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M18 18h12M18 22h8" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" />
        <circle cx="24" cy="32" r="4" stroke="currentColor" stroke-width="1.5" class="icon-seal" />
        <path d="M24 30v4M22 32h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="icon-seal-cross" />
        <circle cx="38" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'network' && (
      <g class="icon-inner">
        <circle cx="24" cy="14" r="5" stroke="currentColor" stroke-width="2" class="icon-node-top" />
        <circle cx="14" cy="32" r="5" stroke="currentColor" stroke-width="2" class="icon-node-left" />
        <circle cx="34" cy="32" r="5" stroke="currentColor" stroke-width="2" class="icon-node-right" />
        <path d="M21 18l-4 11M27 18l4 11M19 32h10" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" />
        <circle cx="24" cy="14" r="2" fill="currentColor" class="icon-accent" opacity="0.5" />
      </g>
    )}

    {name === 'dots' && (
      <g class="icon-inner">
        <circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="2" opacity="0.5" class="icon-dot-1" />
        <circle cx="32" cy="16" r="4" stroke="currentColor" stroke-width="2" opacity="0.7" class="icon-dot-2" />
        <circle cx="16" cy="32" r="4" stroke="currentColor" stroke-width="2" opacity="0.7" class="icon-dot-3" />
        <circle cx="32" cy="32" r="4" stroke="currentColor" stroke-width="2" class="icon-dot-4" />
        <circle cx="32" cy="32" r="1.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'shield' && (
      <g class="icon-inner">
        <path d="M24 6L8 14v10c0 8 6.8 15.4 16 18 9.2-2.6 16-10 16-18V14L24 6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M18 24l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-check" />
        <circle cx="34" cy="12" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'cloud' && (
      <g class="icon-inner">
        <path d="M36 30c4.4 0 8-3.6 8-8s-3.6-8-8-8c-.4 0-.8 0-1.2.1C33.4 8.8 29.2 6 24.5 6c-6.2 0-11.4 4.5-12.4 10.5C7.5 17.5 4 21.4 4 26c0 5.5 4.5 10 10 10h22z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <circle cx="16" cy="26" r="2" fill="currentColor" opacity="0.3" class="icon-cloud-puff-1" />
        <circle cx="22" cy="24" r="1.5" fill="currentColor" opacity="0.2" class="icon-cloud-puff-2" />
        <circle cx="38" cy="14" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'box' && (
      <g class="icon-inner">
        <path d="M24 6L8 14v20l16 8 16-8V14L24 6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M24 6v20M8 14l16 8 16-8" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="36" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'settings' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2" />
        <circle cx="24" cy="24" r="3" fill="currentColor" opacity="0.4" class="icon-gear-hub" />
        <path d="M24 8v4M24 36v4M8 24h4M36 24h4M13.2 13.2l2.8 2.8M32 32l2.8 2.8M13.2 34.8l2.8-2.8M32 16l2.8-2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-gear-spokes" />
      </g>
    )}

    {name === 'database' && (
      <g class="icon-inner">
        <ellipse cx="24" cy="14" rx="12" ry="5" stroke="currentColor" stroke-width="2" />
        <path d="M12 14v10c0 2.8 5.4 5 12 5s12-2.2 12-5V14" stroke="currentColor" stroke-width="2" />
        <path d="M12 24v10c0 2.8 5.4 5 12 5s12-2.2 12-5V24" stroke="currentColor" stroke-width="2" />
        <path d="M12 14c0 2.8 5.4 5 12 5s12-2.2 12-5" stroke="currentColor" stroke-width="1.5" opacity="0.3" class="icon-db-mid" />
        <circle cx="36" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'bolt' && (
      <g class="icon-inner">
        <path d="M26 6L14 26h10l-2 16 14-20h-10l4-16z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="icon-bolt-body" />
        <path d="M22 30l-2 8" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" class="icon-bolt-spark-1" />
        <path d="M28 24l3-3" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" class="icon-bolt-spark-2" />
        <circle cx="36" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'wave' && (
      <g class="icon-inner">
        <path d="M6 24c4-6 8-6 12 0s8 6 12 0 8-6 12 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" class="icon-wave-main" />
        <path d="M6 30c4-4 8-4 12 0s8 4 12 0 8-4 12 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.3" class="icon-wave-sub" />
        <circle cx="38" cy="12" r="2" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'bell' && (
      <g class="icon-inner">
        <path d="M24 8c-5.5 0-10 4.5-10 10v8l-4 6h28l-4-6v-8c0-5.5-4.5-10-10-10z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M21 36a3 3 0 0 0 6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-bell-clapper" />
        <circle cx="24" cy="12" r="2" fill="currentColor" opacity="0.5" class="icon-bell-dot" />
        <circle cx="38" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'list-check' && (
      <g class="icon-inner">
        <rect x="8" y="10" width="32" height="28" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M14 20h6M14 28h6M14 36h6" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" />
        <path d="M26 20l3 3 7-7M26 28l3 3 7-7M26 36l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-check-group" />
      </g>
    )}

    {name === 'robot' && (
      <g class="icon-inner">
        <rect x="14" y="10" width="20" height="16" rx="3" stroke="currentColor" stroke-width="2" />
        <rect x="20" y="26" width="8" height="6" rx="1" stroke="currentColor" stroke-width="2" />
        <circle cx="19" cy="18" r="2" fill="currentColor" opacity="0.5" class="icon-eye-left" />
        <circle cx="29" cy="18" r="2" fill="currentColor" opacity="0.5" class="icon-eye-right" />
        <path d="M22 22h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4" />
        <circle cx="36" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'help' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2" />
        <path d="M19 20a5 5 0 0 1 9.5-2 5 5 0 0 1-2 5.5l-2.5 2v2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="icon-q-curve" />
        <circle cx="24" cy="34" r="2" fill="currentColor" opacity="0.5" class="icon-q-dot" />
      </g>
    )}

    {name === 'ear' && (
      <g class="icon-inner">
        <path d="M16 14c0-4.4 3.6-8 8-8s8 3.6 8 8v12c0 4.4-3.6 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M20 20c2-2 6-2 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5" class="icon-ear-inner" />
        <circle cx="24" cy="28" r="3" stroke="currentColor" stroke-width="2" class="icon-ear-lobe" />
        <circle cx="36" cy="10" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'inbox' && (
      <g class="icon-inner">
        <path d="M8 12l4-6h24l4 6v24a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V12z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M8 12h12l4 6h8l4-6h4" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linejoin="round" class="icon-inbox-flap" />
        <circle cx="24" cy="22" r="3" stroke="currentColor" stroke-width="1.5" opacity="0.5" class="icon-inbox-item" />
      </g>
    )}

    {name === 'flow' && (
      <g class="icon-inner">
        <rect x="10" y="10" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2" opacity="0.4" />
        <rect x="28" y="10" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2" opacity="0.4" />
        <rect x="10" y="28" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2" opacity="0.4" />
        <rect x="28" y="28" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2" class="icon-flow-target" />
        <path d="M20 15h8M15 20v8M33 20v8M20 33h8" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
        <circle cx="38" cy="38" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'brain' && (
      <g class="icon-inner">
        <path d="M18 12c-4 0-8 3-8 8 0 3 1.5 5.5 4 7-1 1.5-1 3.5 0 5 1.5 2 4.5 2.5 7 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" class="icon-brain-left" />
        <path d="M30 12c4 0 8 3 8 8 0 3-1.5 5.5-4 7 1 1.5 1 3.5 0 5-1.5 2-4.5 2.5-7 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" class="icon-brain-right" />
        <path d="M20 18h8M20 22h8M20 26h6" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
        <circle cx="24" cy="16" r="2" fill="currentColor" opacity="0.5" class="icon-brain-pulse" />
      </g>
    )}

    {name === 'check-circle' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="2" />
        <path d="M17 24l5 5 9-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-check-path" />
        <circle cx="36" cy="12" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'check' && (
      <g class="icon-inner">
        <rect x="8" y="8" width="32" height="32" rx="4" stroke="currentColor" stroke-width="2" opacity="0.15" />
        <path d="M14 24l6 6 14-14" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="icon-check-bold" />
      </g>
    )}

    {name === 'zap' && (
      <g class="icon-inner">
        <path d="M28 8L16 24h10l-3 16 14-18h-10l5-14z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="icon-zap-body" />
        <circle cx="14" cy="14" r="2" fill="currentColor" opacity="0.3" class="icon-zap-spark-1" />
        <circle cx="36" cy="36" r="2" fill="currentColor" opacity="0.3" class="icon-zap-spark-2" />
      </g>
    )}

    {name === 'settings-auto' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2" />
        <path d="M24 12v4M24 32v4M12 24h4M32 24h4M16.7 16.7l2.8 2.8M28.5 28.5l2.8 2.8M16.7 31.3l2.8-2.8M28.5 19.5l2.8-2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-gear-spokes" />
        <path d="M22 36l2 4 2-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-auto-arrow" />
      </g>
    )}

    {name === 'lock' && (
      <g class="icon-inner">
        <rect x="12" y="20" width="24" height="20" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M18 20v-6a6 6 0 0 1 12 0v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="24" cy="30" r="2.5" fill="currentColor" opacity="0.4" class="icon-lock-keyhole" />
        <path d="M24 32.5v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4" />
      </g>
    )}

    {name === 'database-search' && (
      <g class="icon-inner">
        <ellipse cx="24" cy="14" rx="10" ry="4" stroke="currentColor" stroke-width="2" />
        <path d="M14 14v10c0 2.2 4.5 4 10 4s10-1.8 10-4V14" stroke="currentColor" stroke-width="2" />
        <path d="M14 24v10c0 2.2 4.5 4 10 4" stroke="currentColor" stroke-width="2" />
        <circle cx="32" cy="32" r="5" stroke="currentColor" stroke-width="2" class="icon-search-ring" />
        <path d="M36 36l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-search-handle" />
      </g>
    )}

    {name === 'api' && (
      <g class="icon-inner">
        <rect x="10" y="12" width="28" height="24" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M10 18h28M16 12v-3M32 12v-3" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
        <path d="M16 28l4-4 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" class="icon-api-chart" />
      </g>
    )}

    {name === 'star' && (
      <g class="icon-inner">
        <path d="M24 8l3.5 10.5H38l-9 6.5 3.5 10.5-9-6.5-9 6.5 3.5-10.5-9-6.5h10.5L24 8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="icon-star-body" />
        <circle cx="24" cy="24" r="3" fill="currentColor" opacity="0.3" class="icon-star-center" />
      </g>
    )}

    {name === 'world' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="15" stroke="currentColor" stroke-width="2" />
        <ellipse cx="24" cy="24" rx="6" ry="15" stroke="currentColor" stroke-width="1.5" opacity="0.3" />
        <path d="M9 24h30M24 9c-3 4-3 10 0 14 3 4 3 10 0 14" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
        <circle cx="36" cy="12" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'link-check' && (
      <g class="icon-inner">
        <path d="M18 26a6 6 0 0 1 0-8l6-6a6 6 0 0 1 8.5 0l.5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.4" />
        <path d="M30 22a6 6 0 0 1 0 8l-6 6a6 6 0 0 1-8.5 0l-.5-.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        <path d="M20 28l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon-check-small" />
      </g>
    )}

    {name === 'list-search' && (
      <g class="icon-inner">
        <path d="M10 14h12M10 22h12M10 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.4" />
        <circle cx="34" cy="30" r="5" stroke="currentColor" stroke-width="2" class="icon-search-ring" />
        <path d="M38 34l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-search-handle" />
        <rect x="10" y="10" width="28" height="28" rx="3" stroke="currentColor" stroke-width="1.5" opacity="0.15" />
      </g>
    )}

    {name === 'link' && (
      <g class="icon-inner">
        <path d="M18 28a6 6 0 0 1 0-8l6-6a6 6 0 0 1 8.5 0l.5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.4" />
        <path d="M30 20a6 6 0 0 1 0 8l-6 6a6 6 0 0 1-8.5 0l-.5-.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
        <circle cx="36" cy="12" r="2.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'stairs' && (
      <g class="icon-inner">
        <rect x="8" y="30" width="12" height="10" rx="2" stroke="currentColor" stroke-width="2" class="icon-step-1" />
        <rect x="20" y="20" width="12" height="10" rx="2" stroke="currentColor" stroke-width="2" class="icon-step-2" />
        <rect x="32" y="10" width="8" height="10" rx="2" stroke="currentColor" stroke-width="2" class="icon-step-3" />
        <path d="M14 30v-4c0-2.2 1.8-4 4-4h6c2.2 0 4-1.8 4-4v-4c0-2.2 1.8-4 4-4h4" stroke="currentColor" stroke-width="1.5" opacity="0.2" stroke-linecap="round" fill="none" />
        <circle cx="38" cy="8" r="2" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'clock' && (
      <g class="icon-inner">
        <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="2" />
        <path d="M24 14v10l6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="icon-clock-hand" />
        <circle cx="24" cy="24" r="2" fill="currentColor" opacity="0.3" />
        <path d="M24 6v2M24 40v2M6 24h2M40 24h2" stroke="currentColor" stroke-width="1.5" opacity="0.2" stroke-linecap="round" />
      </g>
    )}

    {name === 'branch' && (
      <g class="icon-inner">
        <circle cx="14" cy="14" r="4" stroke="currentColor" stroke-width="2" class="icon-node-top" />
        <circle cx="14" cy="34" r="4" stroke="currentColor" stroke-width="2" class="icon-node-left" />
        <circle cx="34" cy="34" r="4" stroke="currentColor" stroke-width="2" class="icon-node-right" />
        <path d="M14 18v8c0 2.2 1.8 4 4 4h8c2.2 0 4 1.8 4 4v4" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" fill="none" />
        <circle cx="14" cy="14" r="1.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'history' && (
      <g class="icon-inner">
        <path d="M24 8v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="24" cy="24" r="12" stroke="currentColor" stroke-width="2" />
        <path d="M24 16v8l5 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="icon-history-hand" />
        <path d="M24 4c-11 0-20 9-20 20s9 20 20 20" stroke="currentColor" stroke-width="1.5" opacity="0.15" stroke-linecap="round" fill="none" class="icon-history-arc" />
      </g>
    )}

    {name === 'git-compare' && (
      <g class="icon-inner">
        <circle cx="16" cy="14" r="4" stroke="currentColor" stroke-width="2" class="icon-node-top" />
        <circle cx="16" cy="34" r="4" stroke="currentColor" stroke-width="2" class="icon-node-left" />
        <circle cx="32" cy="34" r="4" stroke="currentColor" stroke-width="2" class="icon-node-right" />
        <path d="M16 18v8c0 2.2 1.8 4 4 4h8c2.2 0 4 1.8 4 4v4" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" fill="none" />
        <path d="M32 14h4M32 18h4M16 8v-2M16 42v-2" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
      </g>
    )}

    {name === 'flow-branch' && (
      <g class="icon-inner">
        <circle cx="24" cy="12" r="4" stroke="currentColor" stroke-width="2" class="icon-node-top" />
        <circle cx="14" cy="36" r="4" stroke="currentColor" stroke-width="2" class="icon-node-left" />
        <circle cx="34" cy="36" r="4" stroke="currentColor" stroke-width="2" class="icon-node-right" />
        <path d="M24 16v8c0 2.2-1.8 4-4 4h-2c-2.2 0-4 1.8-4 4v4M24 24c0 2.2 1.8 4 4 4h2c2.2 0 4 1.8 4 4v4" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-linecap="round" fill="none" />
        <circle cx="24" cy="12" r="1.5" fill="currentColor" class="icon-accent" />
      </g>
    )}

    {name === 'telescope' && (
