{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@purista/cli": ["packages/cli/src/api/index.ts"],
			"@purista/ai/testing": ["packages/ai/src/testing/index.ts"],
			"@purista/harness/testing": ["packages/ai/node_modules/@purista/harness/dist/testing/index.d.ts"],
			"@purista/*": ["packages/*/src/index.ts"]
		}
	},
	"exclude": [
		"node_modules",
		"dist",
		"examples/ai-basic/src/frontend/**/*",
		"examples/ai-basic/frontend.vite.config.ts",
		"examples/ai-basic/frontend.vitest.config.ts"
	]
}
