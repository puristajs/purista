{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@purista/cli": ["./packages/cli/src/api/index.ts"],
			"@purista/core": ["./packages/core/src/index.ts"],
			"@purista/core/testing": ["./packages/core/src/testing/index.ts"],
			"@purista/core/client": ["./packages/core/src/client/index.ts"],
			"@purista/core/adapter": ["./packages/core/src/adapter/index.ts"],
			"@purista/*": ["./packages/*/src/index.ts"]
		}
	},
	"exclude": [
		"node_modules",
		"dist",
		"web",
		"examples/ai-basic/src/frontend/**/*",
		"examples/ai-basic/frontend.vite.config.ts",
		"examples/ai-basic/frontend.vitest.config.ts"
	]
}
