OPENAI_API_KEY=sk-proj-replace-me
OPENAI_MODEL=gpt-4.1-mini

# Low-effort default: local SQLite + files-only durable workspace under this root.
PURISTA_AI_EXECUTION=local
PURISTA_LOCAL_RUNTIME_ROOT=.local/harness

# Docker Compose: shared PostgreSQL Harness state with process-local files/search.
# PURISTA_AI_EXECUTION=postgres-local
# DATABASE_URL=postgresql://purista:replace-me@postgres:5432/purista

# Kubernetes: PostgreSQL plus restricted Pods, PVC generations and snapshots.
# PURISTA_AI_EXECUTION=kubernetes
# DATABASE_URL=postgresql://purista:replace-me@postgres.example:5432/purista?sslmode=require
# PURISTA_SANDBOX_NAMESPACE=purista-sandboxes
# PURISTA_SANDBOX_IMAGE=ghcr.io/puristajs/harness-sandbox@sha256:replace-me
# PURISTA_HARNESS_RUNTIME_ID=support-v1
# PURISTA_SANDBOX_SERVICE_ACCOUNT=purista-sandbox
# PURISTA_SANDBOX_STORAGE_CLASS=encrypted-rwo
# PURISTA_VOLUME_SNAPSHOT_CLASS=encrypted-rwo-snapshots
