{
	"version": "3.2.2",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"private": true,
	"scripts": {
		"add:service": "purista add service",
		"add:command": "purista add command",
		"add:subscription": "purista add subscription",
		"lint": "bunx @biomejs/biome check",
		"lint:fix": "bunx @biomejs/biome check --write",
		"start": "tsx src/index.ts",
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"test": "tsc --noEmit && vitest",
		"export": "tsx src/export.ts",
		"client:file": "tsx src/generateClientFromFile.ts",
		"client:code": "tsx src/generateClientFromCode.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.10",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"@scalar/hono-api-reference": "^0.11.11"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@purista/cli": "*",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.1",
		"@types/sinon": "^22.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"sinon": "^22.0.0",
		"tsx": "^4.23.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"name": "client-builder"
}
