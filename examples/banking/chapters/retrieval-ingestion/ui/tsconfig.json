{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"allowJs": false,
		"allowImportingTsExtensions": false,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
