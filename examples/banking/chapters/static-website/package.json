{
  "name": "example-bank",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@purista/core": "^4.0.0",
    "@purista/hono-http-server": "^4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@purista/cli": "^4.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sinon": "^22.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.0.1",
    "sinon": "^22.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "scripts": {
    "add:service": "purista add service",
    "add:command": "purista add command",
    "add:subscription": "purista add subscription",
    "add:stream": "purista add stream",
    "add:queue": "purista add queue",
    "add:queue-worker": "purista add queue-worker",
    "add:agent": "purista add agent",
    "start": "tsx src/index.ts",
    "build": "npm run build:server && npm run build:ui",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build:ui && npm run test:server && npm run test:ui",
    "export:runtime": "purista export runtime-capabilities --out purista-runtime.json",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "build:server": "tsc",
    "build:ui": "vite build --config ui/vite.config.ts",
    "test:server": "tsc --noEmit && vitest run --config vitest.server.config.ts",
    "test:ui": "vitest run --config ui/vitest.config.ts"
  }
}
