{
	"name": "@purista/tutorial-rag-agent",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"add:service": "purista add service",
		"add:command": "purista add command",
		"add:stream": "purista add stream",
		"add:agent": "purista add agent",
		"start": "node --env-file-if-exists=.env --import tsx src/index.ts",
		"build": "npm run build:server && npm run build:ui",
		"build:server": "tsc --noEmit",
		"build:ui": "tsc -p ui/tsconfig.json --noEmit && vite build --config ui/vite.config.ts",
		"lint": "biome check .",
		"test": "npm run test:server && npm run test:ui",
		"test:server": "vitest run src/application.test.ts src/service src/harness",
		"test:ui": "vitest run --config ui/vitest.config.ts"
	},
	"dependencies": {
		"@purista/core": "^4.0.0",
		"@purista/harness": "^3.0.0",
		"@purista/harness-ai-sdk-ui": "^3.0.0",
		"@purista/harness-openai": "^3.0.0",
		"@purista/hono-http-server": "^4.0.0",
		"@hono/node-server": "^2.1.0",
		"@ai-sdk/react": "^4.0.15",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-hover-card": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"ai": "^7.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.39.0",
		"nanoid": "^6.0.1",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shiki": "^4.4.3",
		"streamdown": "^2.6.0",
		"tailwind-merge": "^3.6.0",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@purista/cli": "^4.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"jsdom": "^27.4.0",
		"@types/sinon": "^22.0.0",
		"sinon": "^22.1.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"@vitejs/plugin-react": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"vitest": "^4.1.10"
	}
}
