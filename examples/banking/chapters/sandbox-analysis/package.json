{
	"name": "@purista/tutorial-sandbox-analysis",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"add:service": "purista add service",
		"add:command": "purista add command",
		"add:subscription": "purista add subscription",
		"add:stream": "purista add stream",
		"add:queue": "purista add queue",
		"add:queue-worker": "purista add queue-worker",
		"add:agent": "purista add agent",
		"add:workflow": "purista add workflow",
		"add:tool": "purista add tool",
		"add:skill": "purista add skill",
		"add:mcp": "purista add mcp",
		"build": "tsc --noEmit",
		"demo": "node --import tsx src/demo.ts",
		"lint": "biome check .",
		"start": "node --env-file-if-exists=.env --import tsx src/index.ts",
		"test": "vitest run",
		"test:docker": "vitest run src/sandboxAnalysis.docker.integration.test.ts"
	},
	"dependencies": {
		"@purista/core": "^4.0.0",
		"@purista/harness": "^4.0.0",
		"@purista/harness-openai": "^4.0.0",
		"@purista/harness-sandbox-docker": "^4.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@purista/cli": "^4.0.0",
		"@types/node": "^26.2.0",
		"@types/sinon": "^22.0.0",
		"sinon": "^22.1.0",
		"tsx": "^4.23.12",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.10"
	}
}
