{
	"name": "@purista/example-ai-basic",
	"version": "2.2.0",
	"description": "Comprehensive example showing agents, tool calls, agent-to-agent, subscriptions, and HTTP exposure",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n backend,frontend -c blue,green \"npm:backend:dev\" \"npm:frontend:dev\"",
		"backend:dev": "PORT=3001 FRONTEND_DEV=1 tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"frontend:dev": "vite --config frontend.vite.config.ts --host 0.0.0.0 --port 3000 --strictPort",
		"frontend:build": "vite build --config frontend.vite.config.ts",
		"frontend:test": "vitest run -c frontend.vitest.config.ts",
		"frontend:check": "tsc -p tsconfig.frontend.json --noEmit && npm run frontend:test",
		"build": "tsc --noEmit && npm run frontend:build",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"test": "vitest run -c vitest.config.ts && npm run frontend:test && tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit",
		"test:coverage": "vitest run -c vitest.config.ts --coverage"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.31",
		"@hono/node-server": "^1.19.6",
		"@mozilla/readability": "^0.6.0",
		"@purista/ai": "*",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"dotenv": "^16.4.5",
		"jsdom": "^27.0.0",
		"recharts": "^2.15.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@ai-sdk/react": "^3.0.158",
		"@json-render/core": "^0.16.0",
		"@json-render/react": "^0.16.0",
		"@json-render/shadcn": "^0.16.0",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-hover-card": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-use-controllable-state": "^1.2.2",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^25.2.1",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.2",
		"ai": "^6.0.156",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"concurrently": "^9.2.1",
		"lucide-react": "^1.8.0",
		"motion": "^12.38.0",
		"nanoid": "^3.3.11",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-resizable-panels": "^4.9.0",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"use-stick-to-bottom": "^1.1.3",
		"vite": "^7.1.7",
		"vitest": "^4.0.18"
	}
}
