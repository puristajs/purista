{
	"name": "@purista/example-ai-basic",
	"version": "2.2.0",
	"description": "Comprehensive example showing agents, tool calls, agent-to-agent, subscriptions, and HTTP exposure",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx src/index.ts",
		"frontend:dev": "vite --config frontend.vite.config.ts",
		"frontend:build": "vite build --config frontend.vite.config.ts",
		"frontend:test": "vitest run -c frontend.vitest.config.ts",
		"frontend:check": "tsc -p tsconfig.frontend.json --noEmit && npm run frontend:test",
		"build": "tsc --noEmit",
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest run -c vitest.config.ts && npm run frontend:test && tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.31",
		"@hono/node-server": "^1.19.6",
		"@opentelemetry/api": "^1.9.0",
		"@purista/ai": "*",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"@xyflow/react": "^12.10.1",
		"ai": "^6.0.103",
		"ai-sdk-elements": "^0.1.0",
		"dotenv": "^16.4.5",
		"streamdown": "^2.3.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.2.1",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.2",
		"jsdom": "^27.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.7",
		"vitest": "^4.0.18"
	}
}
