{
	"name": "@purista/temporal-example",
	"private": true,
	"version": "3.2.4",
	"description": "PURISTA blueprint project",
	"engines": {
		"node": ">=24.15.0"
	},
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"start": "tsx src/index.ts | pino-pretty",
		"dev": "tsx watch src/index.ts | pino-pretty",
		"dev:worker": "tsx watch src/temporal/worker.ts workflow.watch",
		"test": "tsc --noEmit && vitest",
		"lint": "eslint --ext .ts,.js,.json --cache .",
		"lint:fix": "eslint . --ext .ts,.js,.json --fix",
		"purista": "purista add"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@hono/swagger-ui": "^0.6.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/sdk-node": "^0.221.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"@purista/natsbridge": "*",
		"@temporalio/activity": "^1.22.0",
		"@temporalio/client": "^1.22.0",
		"@temporalio/interceptors-opentelemetry": "^1.22.0",
		"@temporalio/worker": "^1.22.0",
		"@temporalio/workflow": "^1.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/sinon": "^22.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"pino-pretty": "^13.1.3",
		"sinon": "^22.1.0",
		"tsx": "^4.23.12",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^4.1.11"
	}
}
