{
	"name": "@purista/temporal-example",
	"private": true,
	"version": "2.1.3",
	"description": "PURISTA blueprint project",
	"engines": {
		"node": ">=18"
	},
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"start": "tsx src/index.ts | pino-pretty",
		"dev": "tsx watch src/index.ts | pino-pretty",
		"dev:worker": "tsx watch src/temporal/worker.ts workflow.watch",
		"test": "tsc --noEmit && vitest",
		"lint": "eslint --ext .ts,.js,.json --cache .",
		"lint:fix": "eslint . --ext .ts,.js,.json --fix",
		"purista": "purista add"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.0",
		"@hono/swagger-ui": "^0.5.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
		"@opentelemetry/sdk-trace-node": "^2.0.0",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"@purista/natsbridge": "*",
		"@temporalio/activity": "^1.11.7",
		"@temporalio/client": "^1.11.7",
		"@temporalio/interceptors-opentelemetry": "^1.11.7",
		"@temporalio/worker": "^1.11.7",
		"@temporalio/workflow": "^1.11.7",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"@types/node": "^22.13.14",
		"@types/sinon": "^17.0.4",
		"pino-pretty": "^13.0.0",
		"sinon": "^20.0.0",
		"vitest": "^3.1.1"
	}
}
