{
	"name": "@purista/temporal-example",
	"private": true,
	"version": "2.1.5",
	"description": "PURISTA blueprint project",
	"engines": {
		"node": ">=18"
	},
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"start": "tsx src/index.ts | pino-pretty",
		"dev": "tsx watch src/index.ts | pino-pretty",
		"dev:worker": "tsx watch src/temporal/worker.ts workflow.watch",
		"test": "tsc --noEmit && vitest",
		"lint": "eslint --ext .ts,.js,.json --cache .",
		"lint:fix": "eslint . --ext .ts,.js,.json --fix",
		"purista": "purista add"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.7",
		"@hono/swagger-ui": "^0.5.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
		"@opentelemetry/sdk-trace-node": "^2.2.0",
		"@purista/core": "*",
		"@purista/hono-http-server": "*",
		"@purista/natsbridge": "*",
		"@temporalio/activity": "^1.14.0",
		"@temporalio/client": "^1.14.0",
		"@temporalio/interceptors-opentelemetry": "^1.14.0",
		"@temporalio/worker": "^1.14.0",
		"@temporalio/workflow": "^1.14.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"@types/node": "^25.0.3",
		"@types/sinon": "^21.0.0",
		"pino-pretty": "^13.1.3",
		"sinon": "^21.0.1",
		"vitest": "^4.0.16"
	}
}
