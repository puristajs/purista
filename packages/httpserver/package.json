{
	"name": "@purista/httpserver",
	"version": "2.2.0",
	"description": "Simple http server service based on fastify for PURISTA backend framework",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/commonjs/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/commonjs/index.d.ts",
				"default": "./dist/commonjs/index.js"
			}
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.15"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest",
		"build": "rimraf dist && tshy"
	},
	"tshy": {
		"exclude": [
			"src/**/*.test.ts"
		],
		"exports": {
			"./package.json": "./package.json",
			".": "./src/index.ts"
		}
	},
	"devDependencies": {
		"@types/node": "^25.2.1",
		"@types/qs": "^6.14.0",
		"@types/sinon": "^21.0.0",
		"@types/swagger-ui-dist": "^3.30.6",
		"sinon": "^21.0.1",
		"tshy": "^3.1.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@fastify/compress": "^8.3.1",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/static": "^9.0.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/semantic-conventions": "^1.39.0",
		"@purista/core": "*",
		"fastify": "^5.8.5",
		"openapi3-ts": "^4.5.0",
		"swagger-ui-dist": "^5.31.0",
		"trouter": "^4.0.0"
	},
	"peerDependenciesMeta": {},
	"types": "./dist/commonjs/index.d.ts",
	"module": "./dist/esm/index.js"
}
