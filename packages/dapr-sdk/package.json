{
	"name": "@purista/dapr-sdk",
	"version": "3.0.1",
	"description": "SDK and helper to run PURISTA services in Dapr",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"directories": {
		"lib": "lib/esm/index.js",
		"man": "docs",
		"example": "example"
	},
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest",
		"build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.4",
		"@types/node": "^25.9.1",
		"@types/sinon": "^21.0.1",
		"hono": "^4.12.23",
		"sinon": "^22.0.0",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"@purista/base-http-bridge": "*",
		"@purista/core": "*"
	},
	"types": "./dist/index.d.ts"
}
