{
	"name": "@purista/ai",
	"version": "2.2.0",
	"description": "AI builders, runtime services, MCP helpers, and evaluation utilities for the PURISTA framework",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/commonjs/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/commonjs/index.d.ts",
				"default": "./dist/commonjs/index.js"
			}
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.15"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest",
		"test:coverage": "vitest run -c ./vitest.config.ts --coverage",
		"build": "rimraf dist tsconfig.tsbuildinfo && tshy && node ./scripts/assert-build-artifacts.mjs"
	},
	"tshy": {
		"exclude": [
			"src/**/*.test.ts"
		],
		"exports": {
			"./package.json": "./package.json",
			".": "./src/index.ts"
		}
	},
	"devDependencies": {
		"@types/node": "^25.2.1",
		"tshy": "^3.1.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"ai": "^6.0.103",
		"@opentelemetry/api": "^1.9.0",
		"@purista/core": "*",
		"zod": "^4.3.6"
	},
	"types": "./dist/commonjs/index.d.ts",
	"module": "./dist/esm/index.js"
}
