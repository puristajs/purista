{
	"name": "@purista/redis-queue-bridge",
	"version": "3.0.1",
	"description": "Queue bridge implementation backed by Redis lists",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "node ../../scripts/runWithDockerHost.mjs vitest",
		"build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/sinon": "^21.0.1",
		"sinon": "^22.0.0",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"@purista/core": "*",
		"@redis/client": "^5.12.1"
	},
	"peerDependenciesMeta": {},
	"types": "./dist/index.d.ts"
}
