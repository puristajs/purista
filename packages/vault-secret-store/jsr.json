{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@purista/vault-secret-store",
  "version": "2.1.5",
  "description": "State store adapter for HashiCorp Vault",
  "keywords": ["purista", "vault", "hashicorp", "typescript", "javascript"],
  "exports": "./dist/esm/index.js",
  "publish": {
    "include": ["dist/**/*.js", "dist/**/*.d.ts", "README.md", "package.json"],
    "exclude": [
      "src",
      ".github",
      ".vscode",
      ".zed",
      "!dist",
      "!dist/**/*.js",
      "!dist/**/*.d.ts",
      ".tshy",
      ".tshy-build",
      "vendor",
      "docs",
      "typedoc.json",
      "..eslintcache",
      ".npmignore"
    ]
  }
}
