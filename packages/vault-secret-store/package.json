{
	"name": "@purista/vault-secret-store",
	"version": "2.1.5",
	"description": "State store adapter for HashiCorp Vault",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/commonjs/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/commonjs/index.d.ts",
				"default": "./dist/commonjs/index.js"
			}
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18.15"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest",
		"build": "rimraf dist && tshy"
	},
	"tshy": {
		"exclude": [
			"src/**/*.test.ts"
		],
		"exports": {
			"./package.json": "./package.json",
			".": "./src/index.ts"
		}
	},
	"devDependencies": {
		"@types/node": "^25.2.1",
		"@types/sinon": "^21.0.0",
		"sinon": "^21.0.1",
		"testcontainers": "^11.11.0",
		"tshy": "^3.1.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@purista/core": "*",
		"node-vault": "^0.10.5"
	},
	"peerDependenciesMeta": {},
	"types": "./dist/commonjs/index.d.ts",
	"module": "./dist/esm/index.js"
}
