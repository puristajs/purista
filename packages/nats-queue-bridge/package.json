{
	"name": "@purista/nats-queue-bridge",
	"version": "3.2.0",
	"description": "Queue bridge implementation backed by NATS JetStream",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "node ../../scripts/runWithDockerHost.mjs vitest",
		"build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@testcontainers/nats": "^12.0.1",
		"@types/node": "^25.9.1",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@purista/core": "*",
		"nats": "^2.29.3"
	},
	"peerDependenciesMeta": {},
	"types": "./dist/index.d.ts"
}
