{
	"name": "@purista/core",
	"version": "3.2.2",
	"description": "purista backend framework",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"files": [
		"dist",
		"skills"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "tsc --noEmit && vitest -c ../../vitest.config.ts",
		"build": "rimraf dist skills tsconfig.tsbuildinfo && tsc -p tsconfig.build.json && node ../../scripts/syncPackageSkills.mjs .",
		"test:integration": "vitest -c ../../vitest.config.ts"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/sinon": "^22.0.0",
		"rimraf": "^6.1.3",
		"vitest": "^4.1.10",
		"yup": "^1.7.1"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/resources": "^2.9.0",
		"@opentelemetry/sdk-trace-node": "^2.9.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@purista/harness": "^1.7.1",
		"@sodaru/yup-to-json-schema": "^2.0.1",
		"@standard-schema/spec": "^1.1.0",
		"code-block-writer": "^13.0.3",
		"openapi3-ts": "^4.6.0",
		"pino": "^10.3.1",
		"sinon": "^22.0.0",
		"ts-deepmerge": "^8.0.0",
		"zod": "^4.4.3"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts"
}
