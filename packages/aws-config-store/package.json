{
	"name": "@purista/aws-config-store",
	"version": "3.0.1",
	"description": "State store adapter for AWS System Manager",
	"homepage": "https://purista.dev",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/puristajs/purista.git"
	},
	"author": "Sebastian Wessel",
	"license": "ISC",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/**/*"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"lint": "npx @biomejs/biome check --write",
		"test": "vitest",
		"build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
		"env:up": "docker compose -f docker-compose.yml up -d --pull never",
		"env:down": "docker compose -f docker-compose.yml down"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/sinon": "^21.0.1",
		"sinon": "^22.0.0",
		"testcontainers": "^12.0.1",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@aws-sdk/client-ssm": "^3.1060.0",
		"@purista/core": "*"
	},
	"peerDependenciesMeta": {},
	"types": "./dist/index.d.ts"
}
